        # 机器学习模型
        self.error_classifier = DecisionTreeClassifier()
        self.error_clusterer = DBSCAN(eps=0.5, min_samples=5)
        self.models_trained = False
        
        # 错误知识库
        self.knowledge_base: Dict[str, Any] = {
