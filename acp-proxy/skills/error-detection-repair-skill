class ErrorType(Enum):
    RUNTIME = "runtime"
    PERFORMANCE = "performance"
    LOGIC = "logic"
    RESOURCE_LEAK = "resource_leak"
    UNKNOWN = "unknown"


class RepairPriority(Enum):
    CRITICAL = 1
    HIGH = 2
    MEDIUM = 3
    LOW = 4


@dataclass
class ErrorLog:
    """Data class to represent an error log entry"""
    timestamp: datetime
    error_type: ErrorType
    message: str
    stack_trace: str
    system_logs: List[str]
    performance_metrics: Dict[str, float]
    resource_usage: Dict[str, float]
    context: Dict[str, Any]
    error_id: str = None
    
    def __post_init__(self):
        if not self.error_id:
            # Generate unique error ID
            hash_input = f"{self.timestamp}{self.message}{self.stack_trace}"
            self.error_id = hashlib.md5(hash_input.encode()).hexdigest()


@dataclass
class RepairStrategy:
    """Data class for repair strategies"""
    strategy_id: str
    error_type: ErrorType
    description: str
    fix_type: str  # 'temporary' or 'permanent'
    confidence: float
    estimated_time: float
    side_effects: List[str]
    stability_score: float
    implementation_code: str = None


@dataclass
class RepairResult:
    """Data class for repair execution results"""
    strategy_id: str
    success: bool
    execution_time: float
    before_metrics: Dict[str, float]
    after_metrics: Dict[str, float]
    verification_passed: bool
    details: str


class ErrorPatternLearner:
    """Machine learning module for learning error patterns"""
    
    def __init__(self):
        self.classifier = DecisionTreeClassifier()
        self.cluster_model = DBSCAN(eps=0.5, min_samples=2)
        self.scaler = StandardScaler()
        self.is_trained = False
        self.feature_names = []
        self.patterns = {}
        
    def extract_features(self, error_log: ErrorLog) -> np.ndarray:
        """Extract features from error log for ML models"""
        features = []
        
        # Time-based features
        features.append(error_log.timestamp.hour)
        features.append(error_log.timestamp.weekday())
        
        # Performance metrics
        if 'response_time' in error_log.performance_metrics:
            features.append(error_log.performance_metrics['response_time'])
        else:
            features.append(0)
            
        if 'cpu_usage' in error_log.performance_metrics:
            features.append(error_log.performance_metrics['cpu_usage'])
        else:
            features.append(0)
            
        # Resource usage
        if 'memory_usage' in error_log.resource_usage:
            features.append(error_log.resource_usage['memory_usage'])
        else:
            features.append(0)
            
        # Error type encoding
        type_map = {
            ErrorType.RUNTIME: 0,
            ErrorType.PERFORMANCE: 1,
            ErrorType.LOGIC: 2,
            ErrorType.RESOURCE_LEAK: 3,
            ErrorType.UNKNOWN: 4
        }
        features.append(type_map.get(error_log.error_type, 4))
        
        # Message length as proxy for complexity
        features.append(len(error_log.message))
        
        # Stack trace depth
        stack_lines = error_log.stack_trace.split('\n')
        features.append(len(stack_lines))
        
        return np.array(features).reshape(1, -1)
    
    def train_classifier(self, error_logs: List[ErrorLog], labels: List[str]):
        """Train error type classifier"""
        if not error_logs:
            return
            
        X = np.vstack([self.extract_features(log) for log in error_logs])
        y = np.array(labels)
        
        # Scale features
        X_scaled = self.scaler.fit_transform(X)
        
        # Train classifier
        self.classifier.fit(X_scaled, y)
        self.is_trained = True
        
        # Update feature names
        self.feature_names = [
            'hour', 'weekday', 'response_time', 'cpu_usage',
            'memory_usage', 'error_type_encoded', 'message_length',
            'stack_trace_depth'
        ]
        
        logger.info("Error classifier trained successfully")
    
    def predict_error_type(self, error_log: ErrorLog) -> Tuple[str, float]:
        """Predict error type using trained classifier"""
        if not self.is_trained:
            return ErrorType.UNKNOWN.value, 0.0
            
        features = self.extract_features(error_log)
        features_scaled = self.scaler.transform(features)
        
        prediction = self.classifier.predict(features_scaled)[0]
        confidence = np.max(self.classifier.predict_proba(features_scaled))
        
        return prediction, confidence
    
    def cluster_errors(self, error_logs: List[ErrorLog]) -> Dict[int, List[ErrorLog]]:
        """Cluster similar errors using DBSCAN"""
        if not error_logs:
            return {}
            
        X = np.vstack([self.extract_features(log) for log in error_logs])
        X_scaled = self.scaler.transform(X)
        
        clusters = self.cluster_model.fit_predict(X_scaled)
        
        clustered_errors = defaultdict(list)
        for idx, cluster_id in enumerate(clusters):
            clustered_errors[cluster_id].append(error_logs[idx])
            
        return clustered_errors
    
    def update_patterns(self, error_log: ErrorLog, solution: RepairStrategy):
        """Update error patterns with new solutions"""
        error_hash = hashlib.md5(
            f"{error_log.error_type}{error_log.message[:100]}".encode()
        ).hexdigest()
        
        if error_hash not in self.patterns:
            self.patterns[error_hash] = {
                'count': 1,
                'solutions': [solution],
                'last_seen': datetime.now()
            }
        else:
            self.patterns[error_hash]['count'] += 1
            self.patterns[error_hash]['solutions'].append(solution)
            self.patterns[error_hash]['last_seen'] = datetime.now()
            
            # Keep only top 5 solutions
            self.patterns[error_hash]['solutions'] = sorted(
                self.patterns[error_hash]['solutions'],
                key=lambda x: x.confidence,
                reverse=True
            )[:5]


class ErrorKnowledgeBase:
    """Error knowledge base with incremental learning"""
    
    def __init__(self, db_path: str = "error_knowledge.db"):
        self.db_path = db_path
        self.errors = {}
