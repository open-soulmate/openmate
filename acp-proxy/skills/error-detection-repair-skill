        # 初始化错误模式库
        self._initialize_error_patterns()
        
        # 加载预训练模型（如果有）
        self._load_models()
        
        logger.info("错误检测与修复技能初始化完成")
    
    def _initialize_error_patterns(self):
        """初始化常见错误模式库"""
        self.knowledge_base['error_patterns'] = {
            'null_pointer': {
                'type': ErrorType.RUNTIME_ERROR,
                'pattern': r'NullPointerException|NullPointerError',
                'solution': '添加空值检查，确保对象初始化'
            },
            'memory_leak': {
                'type': ErrorType.RESOURCE_ERROR,
                'pattern': r'MemoryError|OutOfMemory',
                'solution': '检查资源释放，优化内存使用'
            },
            'timeout': {
                'type': ErrorType.PERFORMANCE_ERROR,
                'pattern': r'TimeoutError|ConnectionTimeout',
                'solution': '优化响应时间，增加超时设置'
            },
            'infinite_loop': {
                'type': ErrorType.LOGIC_ERROR,
                'pattern': r'InfiniteLoopError|StackOverflow',
