            "source_module": error_log.source_module,
            "time_hour": error_log.timestamp.hour,
            "time_weekday": error_log.timestamp.weekday(),
            "cpu_usage": error_log.system_metrics.get("cpu_usage", 0),
            "memory_usage": error_log.system_metrics.get("memory_usage", 0),
            "response_time": error_log.system_metrics.get("response_time", 0),
