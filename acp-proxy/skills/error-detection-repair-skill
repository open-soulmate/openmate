                if usage > limit:
                    issues.append({
                        "type": "resource_exceeded",
                        "resource": resource,
                        "usage": usage,
                        "limit": limit,
                        "timestamp": timestamp,
                        "severity": "HIGH" if usage > limit * 1.2 else "MEDIUM"
                    })
        
        # 检测资源泄漏
        self.resource_usage_history.append((timestamp, current_usage))
        
