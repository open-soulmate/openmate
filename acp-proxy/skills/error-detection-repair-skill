class PerformanceMonitor:
    """性能监控器"""
    
    def __init__(self):
        self.thresholds = {
            "response_time": 2.0,  # 秒
            "cpu_usage": 80.0,     # 百分比
            "memory_usage": 85.0,  # 百分比
            "disk_io": 100.0,      # MB/s
            "network_latency": 100  # 毫秒
        }
        self.history = defaultdict(list)
        self.baselines = {}
    
    def check_performance(self, metrics: Dict[str, Any]) -> List[Dict[str, Any]]:
        """检查性能指标是否超过阈值"""
        anomalies = []
        
        for metric_name, value in metrics.items():
            if metric_name in self.thresholds:
                if value > self.thresholds[metric_name]:
                    anomalies.append({
                        "metric": metric_name,
                        "value": value,
                        "threshold": self.thresholds[metric_name],
                        "severity": self._calculate_severity(value, self.thresholds[metric_name]),
                        "timestamp": datetime.now().isoformat()
                    })
        
        return anomalies
    
    def _calculate_severity(self, value: float, threshold: float) -> str:
        """计算异常严重程度"""
        ratio = value / threshold
        if ratio > 2.0:
            return "CRITICAL"
        elif ratio > 1.5:
            return "HIGH"
        elif ratio > 1.2:
            return "MEDIUM"
        else:
            return "LOW"
    
    def update_baseline(self, metric_name: str, value: float):
        """更新基线值"""
        if metric_name not in self.history:
            self.history[metric_name] = []
        
        self.history[metric_name].append(value)
        
        # 保留最近1000个值
        if len(self.history[metric_name]) > 1000:
            self.history[metric_name].pop(0)
        
        # 更新基线（使用最近100个值的平均值）
        if len(self.history[metric_name]) >= 100:
            self.baselines[metric_name] = np.mean(self.history[metric_name][-100:])


