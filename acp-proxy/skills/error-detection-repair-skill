    def _load_models(self):
        """加载预训练的机器学习模型"""
        try:
            # 尝试加载已训练的模型
            self.error_classifier = joblib.load('error_classifier.pkl')
            self.error_clusterer = joblib.load('error_clusterer.pkl')
            self.models_trained = True
            logger.info("已加载预训练的错误分类和聚类模型")
        except FileNotFoundError:
            logger.warning("未找到预训练模型，将在首次使用时进行训练")
            self.models_trained = False
    
    def detect_errors(self) -> List[ErrorLog]:
        """
        执行多维度错误检测
        
        Returns:
            List[ErrorLog]: 检测到的错误列表
        """
        logger.info("开始执行错误检测...")
        detected_errors = []
        
        # 1. 运行时错误监控
        runtime_errors = self._monitor_runtime_errors()
        detected_errors.extend(runtime_errors)
        
        # 2. 性能异常监控
        performance_errors = self._monitor_performance_errors()
        detected_errors.extend(performance_errors)
        
        # 3. 逻辑错误检测
        logic_errors = self._detect_logic_errors()
        detected_errors.extend(logic_errors)
        
        # 4. 资源泄漏监控
        resource_errors = self._monitor_resource_leaks()
        detected_errors.extend(resource_errors)
        
        # 保存检测到的错误
        for error in detected_errors:
            self.error_logs[error.error_id] = error
            self.error_history.append(error)
            self.knowledge_base['statistics']['total_errors'] += 1
        
        logger.info(f"错误检测完成，共检测到 {len(detected_errors)} 个错误")
        return detected_errors
    
