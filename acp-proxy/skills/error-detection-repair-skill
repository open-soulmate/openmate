        """从错误日志中学习模式"""
        # 提取特征
        features = self._extract_features(error_log)
        self.training_data.append(features)
        
        # 更新模式库
        pattern_key = self._generate_pattern_key(error_log)
        self.error_patterns[pattern_key].append(error_log)
        
