            "cpu": {"max": 100, "unit": "percent"},  # 最大CPU使用
            "connections": {"max": 1000, "unit": "count"},  # 最大连接数
            "open_files": {"max": 1024, "unit": "count"}  # 最大打开文件数
        }
        self.resource_usage_history = []
        self.leak_detection_window = 60  # 秒
    
    def monitor_resources(self, current_usage: Dict[str, Any]) -> List[Dict[str, Any]]:
