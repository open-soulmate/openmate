class ErrorType(Enum):
    """Error type classification"""
    RUNTIME = "runtime"
    PERFORMANCE = "performance"
    LOGICAL = "logical"
    RESOURCE_LEAK = "resource_leak"
    SYSTEM = "system"
    NETWORK = "network"
    UNKNOWN = "unknown"


class RepairUrgency(Enum):
    """Repair urgency levels"""
    CRITICAL = "critical"
    HIGH = "high"
    MEDIUM = "medium"
    LOW = "low"


@dataclass
class ErrorLog:
    """Error log data structure"""
    timestamp: datetime
    error_type: ErrorType
    message: str
    stack_trace: Optional[str] = None
    system_metrics: Optional[Dict] = None
    context: Optional[Dict] = None
    root_cause: Optional[str] = None
    severity: float = 0.0  # 0-1 scale
    
    def to_dict(self) -> Dict:
        """Convert to dictionary for serialization"""
        result = asdict(self)
        result['timestamp'] = self.timestamp.isoformat()
        result['error_type'] = self.error_type.value
        return result
    
    @classmethod
    def from_dict(cls, data: Dict) -> 'ErrorLog':
        """Create from dictionary"""
        data['timestamp'] = datetime.fromisoformat(data['timestamp'])
        data['error_type'] = ErrorType(data['error_type'])
        return cls(**data)


@dataclass
class RepairStrategy:
    """Repair strategy data structure"""
    strategy_id: str
    error_type: ErrorType
    description: str
    steps: List[str]
    estimated_time: float  # seconds
    stability_score: float  # 0-1 scale
    side_effects: List[str]
    rollback_plan: Optional[str] = None
    priority: RepairUrgency = RepairUrgency.MEDIUM
    
    def to_dict(self) -> Dict:
        """Convert to dictionary"""
        result = asdict(self)
        result['error_type'] = self.error_type.value
        result['priority'] = self.priority.value
        return result


@dataclass
class RepairResult:
    """Repair result data structure"""
    strategy_id: str
    success: bool
    execution_time: float
    verification_result: bool
    error_reduction: float  # percentage
    timestamp: datetime
    details: Optional[str] = None
    
    def to_dict(self) -> Dict:
        """Convert to dictionary"""
        result = asdict(self)
        result['timestamp'] = self.timestamp.isoformat()
        return result


class ErrorKnowledgeBase:
    """Error knowledge base with incremental learning"""
    
    def __init__(self, base_path: str = "error_knowledge_base"):
        self.base_path = Path(base_path)
        self.base_path.mkdir(exist_ok=True)
        
        # Knowledge storage
        self.error_patterns: Dict[str, Dict] = {}  # pattern_hash -> pattern_data
        self.repair_strategies: Dict[str, List[RepairStrategy]] = defaultdict(list)  # error_type -> strategies
        self.repair_history: List[RepairResult] = []
        
        # Machine learning components
        self.error_classifier = None
        self.pattern_clusters = None
        self.training_data: List[Tuple[Dict, str]] = []  # (features, error_type)
        
        # Load existing knowledge
        self._load_knowledge()
    
    def _load_knowledge(self):
        """Load existing knowledge from disk"""
        try:
            patterns_file = self.base_path / "error_patterns.pkl"
            if patterns_file.exists():
                with open(patterns_file, 'rb') as f:
                    self.error_patterns = pickle.load(f)
            
            strategies_file = self.base_path / "repair_strategies.pkl"
            if strategies_file.exists():
                with open(strategies_file, 'rb') as f:
                    self.repair_strategies = pickle.load(f)
            
            history_file = self.base_path / "repair_history.pkl"
            if history_file.exists():
                with open(history_file, 'rb') as f:
                    self.repair_history = pickle.load(f)
            
            training_file = self.base_path / "training_data.pkl"
            if training_file.exists():
                with open(training_file, 'rb') as f:
                    self.training_data = pickle.load(f)
            
            # Load ML models if exist
            classifier_file = self.base_path / "error_classifier.pkl"
            if classifier_file.exists():
                with open(classifier_file, 'rb') as f:
                    self.error_classifier = pickle.load(f)
            
            clusters_file = self.base_path / "pattern_clusters.pkl"
            if clusters_file.exists():
                with open(clusters_file, 'rb') as f:
                    self.pattern_clusters = pickle.load(f)
            
            logger.info(f"Loaded {len(self.error_patterns)} patterns, "
                       f"{sum(len(strategies) for strategies in self.repair_strategies.values())} strategies")
        except Exception as e:
            logger.error(f"Error loading knowledge base: {e}")
    
    def save_knowledge(self):
        """Save knowledge to disk"""
        try:
            with open(self.base_path / "error_patterns.pkl", 'wb') as f:
                pickle.dump(self.error_patterns, f)
            
            with open(self.base_path / "repair_strategies.pkl", 'wb') as f:
                pickle.dump(self.repair_strategies, f)
            
            with open(self.base_path / "repair_history.pkl", 'wb') as f:
                pickle.dump(self.repair_history, f)
            
            with open(self.base_path / "training_data.pkl", 'wb') as f:
                pickle.dump(self.training_data, f)
            
            if self.error_classifier:
                with open(self.base_path / "error_classifier.pkl", 'wb') as f:
                    pickle.dump(self.error_classifier, f)
            
            if self.pattern_clusters:
                with open(self.base_path / "pattern_clusters.pkl", 'wb') as f:
                    pickle.dump(self.pattern_clusters, f)
            
            logger.info("Knowledge base saved successfully")
        except Exception as e:
            logger.error(f"Error saving knowledge base: {e}")
    
