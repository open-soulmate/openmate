class ErrorType(Enum):
    """错误类型枚举"""
    RUNTIME_ERROR = "runtime_error"
    PERFORMANCE_ANOMALY = "performance_anomaly"
    LOGIC_ERROR = "logic_error"
    RESOURCE_LEAK = "resource_leak"
    NETWORK_ERROR = "network_error"
    TIMEOUT_ERROR = "timeout_error"
    MEMORY_ERROR = "memory_error"
    UNKNOWN = "unknown"


class ErrorSeverity(Enum):
    """错误严重程度"""
    LOW = "low"
    MEDIUM = "medium"
    HIGH = "high"
    CRITICAL = "critical"


@dataclass
class ErrorLog:
    """错误日志数据结构"""
    timestamp: datetime
    error_type: ErrorType
    error_message: str
    error_traceback: str
    system_metrics: Dict[str, Any]
    context: Dict[str, Any]
    severity: ErrorSeverity
    occurrence_count: int = 1
    last_occurrence: datetime = None
    
    def __post_init__(self):
        if self.last_occurrence is None:
            self.last_occurrence = self.timestamp
        self.error_id = self._generate_error_id()
    
    def _generate_error_id(self) -> str:
        """生成错误唯一标识"""
        content = f"{self.error_type.value}:{self.error_message[:100]}"
        return hashlib.md5(content.encode()).hexdigest()
    
    def to_dict(self) -> Dict[str, Any]:
        """转换为字典"""
        data = asdict(self)
        data['timestamp'] = self.timestamp.isoformat()
        data['last_occurrence'] = self.last_occurrence.isoformat()
        data['error_type'] = self.error_type.value
        data['severity'] = self.severity.value
        return data


@dataclass
class RepairStrategy:
    """修复策略数据结构"""
    strategy_id: str
    error_type: ErrorType
    repair_type: str  # temporary, permanent
    steps: List[str]
    estimated_time: float  # 秒
    success_probability: float
    side_effects: List[str]
    rollback_plan: List[str]
    validation_checks: List[str]
    created_at: datetime = None
    
    def __post_init__(self):
        if self.created_at is None:
            self.created_at = datetime.now()


class ErrorKnowledgeBase:
    """错误知识库 - 存储和管理错误模式与解决方案"""
    
    def __init__(self, db_path: str = "error_knowledge.db"):
        self.db_path = db_path
        self._init_database()
        self.error_patterns = defaultdict(list)
        self.repair_strategies = {}
        self._load_knowledge()
        
    def _init_database(self):
        """初始化数据库"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        # 创建错误日志表
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS error_logs (
                id TEXT PRIMARY KEY,
                timestamp DATETIME,
                error_type TEXT,
                error_message TEXT,
                error_traceback TEXT,
                system_metrics TEXT,
                context TEXT,
                severity TEXT,
                occurrence_count INTEGER DEFAULT 1,
                last_occurrence DATETIME,
                solution_applied TEXT,
                resolution_time REAL,
                success BOOLEAN
            )
        ''')
        
        # 创建修复策略表
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS repair_strategies (
                strategy_id TEXT PRIMARY KEY,
                error_type TEXT,
                repair_type TEXT,
                steps TEXT,
                estimated_time REAL,
                success_probability REAL,
                side_effects TEXT,
                validation_checks TEXT,
                usage_count INTEGER DEFAULT 0,
                success_count INTEGER DEFAULT 0,
                created_at DATETIME
            )
        ''')
        
        # 创建错误模式表
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS error_patterns (
                pattern_id TEXT PRIMARY KEY,
                error_type TEXT,
                pattern_signature TEXT,
                frequency INTEGER DEFAULT 1,
                common_solution TEXT,
                avg_resolution_time REAL,
                success_rate REAL,
                last_seen DATETIME
            )
        ''')
        
        conn.commit()
        conn.close()
    
    def add_error_log(self, error_log: ErrorLog):
        """添加错误日志到知识库"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        try:
            # 检查是否已存在相同错误
            cursor.execute(
                "SELECT occurrence_count, last_occurrence FROM error_logs WHERE id = ?",
                (error_log.error_id,)
            )
            result = cursor.fetchone()
            
            if result:
                # 更新已存在的错误
                occurrence_count = result[0] + 1
                cursor.execute('''
                    UPDATE error_logs 
                    SET occurrence_count = ?, last_occurrence = ?, 
                        system_metrics = ?, context = ?
                    WHERE id = ?
                ''', (occurrence_count, datetime.now(), 
                     json.dumps(error_log.system_metrics),
                     json.dumps(error_log.context),
                     error_log.error_id))
            else:
                # 插入新错误
                cursor.execute('''
                    INSERT INTO error_logs 
                    (id, timestamp, error_type, error_message, error_traceback,
                     system_metrics, context, severity, occurrence_count, last_occurrence)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                ''', (
                    error_log.error_id,
                    error_log.timestamp,
                    error_log.error_type.value,
                    error_log.error_message,
                    error_log.error_traceback,
                    json.dumps(error_log.system_metrics),
                    json.dumps(error_log.context),
                    error_log.severity.value,
                    error_log.occurrence_count,
                    error_log.last_occurrence
                ))
            
            conn.commit()
        finally:
            conn.close()
    
    def add_repair_strategy(self, strategy: RepairStrategy):
        """添加修复策略到知识库"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        try:
            cursor.execute('''
                INSERT OR REPLACE INTO repair_strategies 
                (strategy_id, error_type, repair_type, steps, estimated_time,
                 success_probability, side_effects, validation_checks, created_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', (
                strategy.strategy_id,
                strategy.error_type.value,
                strategy.repair_type,
                json.dumps(strategy.steps),
                strategy.estimated_time,
                strategy.success_probability,
                json.dumps(strategy.side_effects),
                json.dumps(strategy.validation_checks),
                strategy.created_at
            ))
            
            conn.commit()
        finally:
            conn.close()
    
