import logging
import json
from typing import Dict, List, Optional, Any
from datetime import datetime
from .error_monitor import ErrorMonitor
from .pattern_learner import PatternLearner
from .root_cause_analyzer import RootCauseAnalyzer
from .repair_strategy_generator import RepairStrategyGenerator
from .auto_repair_executor import AutoRepairExecutor
from .error_knowledge_base import ErrorKnowledgeBase

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class ErrorDetectionRepairSkill:
    """错误检测与修复技能主类"""
    
    def __init__(self):
        """初始化错误检测与修复技能组件"""
        self.error_monitor = ErrorMonitor()
        self.pattern_learner = PatternLearner()
        self.root_cause_analyzer = RootCauseAnalyzer()
        self.repair_generator = RepairStrategyGenerator()
        self.repair_executor = AutoRepairExecutor()
        self.knowledge_base = ErrorKnowledgeBase()
        self.repair_statistics = {
            "total_attempts": 0,
            "successful_repairs": 0,
            "failed_repairs": 0,
            "repair_history": []
        }
        logger.info("错误检测与修复技能初始化完成")
    
    def detect_errors(self) -> List[Dict[str, Any]]:
        """
        检测系统中的错误
        
        Returns:
            List[Dict]: 检测到的错误列表，每个错误包含类型、时间、详情等信息
        """
        logger.info("开始错误检测")
        
        # 多维度错误监控
        runtime_errors = self.error_monitor.monitor_runtime_errors()
        performance_anomalies = self.error_monitor.monitor_performance_anomalies()
        logic_errors = self.error_monitor.monitor_logic_errors()
        resource_leaks = self.error_monitor.monitor_resource_leaks()
        
        # 合并所有错误
        all_errors = runtime_errors + performance_anomalies + logic_errors + resource_leaks
        
        # 记录错误到知识库
        for error in all_errors:
            self.knowledge_base.record_error(error)
        
        logger.info(f"检测到 {len(all_errors)} 个错误")
        return all_errors
    
    def analyze_error(self, error_log: Dict[str, Any]) -> Dict[str, Any]:
        """
        分析单个错误，确定根因
        
        Args:
            error_log: 错误日志信息
            
        Returns:
            Dict: 错误分析结果，包含根因、影响范围等
        """
        logger.info(f"分析错误: {error_log.get('error_id', 'unknown')}")
        
        # 模式识别 - 从历史错误中学习模式
        similar_patterns = self.pattern_learner.find_similar_patterns(error_log)
        
        # 根因分析 - 结合多个维度数据
        root_cause = self.root_cause_analyzer.analyze(
            error_log=error_log,
            system_logs=self.error_monitor.get_system_logs(),
            performance_metrics=self.error_monitor.get_performance_metrics(),
            resource_usage=self.error_monitor.get_resource_usage()
        )
        
        # 构建分析结果
        analysis_result = {
            "error_log": error_log,
            "root_cause": root_cause,
            "similar_patterns": similar_patterns,
            "analysis_timestamp": datetime.now().isoformat(),
            "confidence_score": self._calculate_confidence(root_cause, similar_patterns)
        }
        
        # 更新知识库
        self.knowledge_base.update_analysis(error_log['error_id'], analysis_result)
        
        return analysis_result
    
    def generate_repair_strategy(self, error_type: str, analysis_result: Dict[str, Any]) -> List[Dict[str, Any]]:
        """
        根据错误类型和分析结果生成修复策略
        
        Args:
            error_type: 错误类型
            analysis_result: 错误分析结果
            
        Returns:
            List[Dict]: 修复策略列表，每个策略包含修复步骤、预期效果等
        """
        logger.info(f"为错误类型 {error_type} 生成修复策略")
        
        # 获取历史修复记录
        historical_repairs = self.knowledge_base.get_historical_repairs(error_type)
        
        # 生成修复策略
        strategies = self.repair_generator.generate(
            error_type=error_type,
            analysis_result=analysis_result,
            historical_repairs=historical_repairs,
            system_state=self.error_monitor.get_current_state()
        )
        
        # 评估每个策略的优缺点
        evaluated_strategies = []
        for strategy in strategies:
            evaluated = self.repair_generator.evaluate_strategy(strategy)
            evaluated_strategies.append(evaluated)
        
        # 按优先级排序策略
        sorted_strategies = self.repair_generator.prioritize_strategies(evaluated_strategies)
        
        logger.info(f"生成了 {len(sorted_strategies)} 个修复策略")
        return sorted_strategies
    
