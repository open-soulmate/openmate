class ErrorType(Enum):
    """错误类型枚举"""
    RUNTIME_ERROR = "runtime_error"
    PERFORMANCE_ANOMALY = "performance_anomaly"
    LOGIC_ERROR = "logic_error"
    RESOURCE_LEAK = "resource_leak"
    SYSTEM_ERROR = "system_error"


class RepairAction(Enum):
    """修复动作枚举"""
    QUICK_FIX = "quick_fix"
    STABLE_FIX = "stable_fix"
    PERMANENT_FIX = "permanent_fix"
    ROLLBACK = "rollback"


@dataclass
class ErrorEvent:
    """错误事件数据结构"""
    timestamp: datetime
    error_type: ErrorType
    error_message: str
    stack_trace: Optional[str] = None
    system_metrics: Optional[Dict] = None
    context_info: Optional[Dict] = None
    severity: int = 5  # 1-10, 10最严重


@dataclass
class ErrorPattern:
    """错误模式数据结构"""
    pattern_id: str
    error_type: ErrorType
    signature: str  # 错误特征
    frequency: int = 0
    success_rate: float = 0.0  # 历史修复成功率
    solutions: List[Dict] = None
    last_occurred: datetime = None
    ml_features: Optional[np.ndarray] = None


@dataclass
class RepairStrategy:
    """修复策略数据结构"""
    strategy_id: str
    action_type: RepairAction
    description: str
    target_component: str
    repair_steps: List[Dict]
    estimated_time: float  # 秒
    stability_score: float  # 0-1
    side_effects: List[str] = None
    priority: int = 1  # 1-5, 5最高


@dataclass
class RepairResult:
    """修复结果数据结构"""
    strategy_used: str
    success: bool
    execution_time: float
    verification_result: Dict
    side_effects_observed: List[str] = None
    improvements: List[str] = None


class ErrorDetectionRepairSkill:
    """
    错误检测与修复技能
    实现错误自修复能力，包括多维度监控、模式学习、根因分析、策略生成、自动修复和知识库建设
    """
    
    def __init__(self, config: Optional[Dict] = None):
        """
        初始化错误检测与修复技能
        
        Args:
            config: 配置参数
        """
        self.config = config or {}
        self._init_components()
        self._load_or_create_knowledge_base()
        
    def _init_components(self):
        """初始化各组件"""
        # 错误监控配置
        self.performance_thresholds = {
            'response_time': self.config.get('response_time_threshold', 2.0),  # 秒
            'cpu_usage': self.config.get('cpu_usage_threshold', 80),  # 百分比
            'memory_usage': self.config.get('memory_usage_threshold', 85),  # 百分比
            'error_rate': self.config.get('error_rate_threshold', 0.01)  # 1%
        }
        
        # 机器学习模型
        self.error_classifier = None
        self.anomaly_detector = None
        self.scaler = StandardScaler()
        
        # 错误模式库
        self.error_patterns = {}
        self.pattern_counter = 0
        
        # 修复策略库
        self.repair_strategies = {}
        self.strategy_counter = 0
        
        # 知识库
        self.knowledge_base = {
            'error_history': [],
            'repair_history': [],
            'success_rates': {},
            'pattern_library': {},
            'performance_benchmarks': {}
        }
        
        # 监控状态
        self.monitoring_active = False
        self.current_errors = []
        self.monitoring_thread = None
        
        # 统计信息
        self.stats = {
            'total_detections': 0,
            'total_repairs': 0,
            'successful_repairs': 0,
            'average_repair_time': 0.0,
            'error_trends': defaultdict(list)
        }
        
        # 线程锁
        self.lock = threading.RLock()
        
    def _load_or_create_knowledge_base(self, kb_path: Optional[str] = None):
        """加载或创建知识库"""
        self.kb_path = kb_path or f"error_knowledge_base_{datetime.now().strftime('%Y%m%d')}.pkl"
        try:
            with open(self.kb_path, 'rb') as f:
                self.knowledge_base = pickle.load(f)
                logger.info(f"已加载知识库: {len(self.knowledge_base.get('error_history', []))} 条错误记录")
        except FileNotFoundError:
            logger.info("创建新的知识库")
            self._save_knowledge_base()
            
    def _save_knowledge_base(self):
        """保存知识库到文件"""
        try:
            with open(self.kb_path, 'wb') as f:
                pickle.dump(self.knowledge_base, f)
        except Exception as e:
            logger.error(f"保存知识库失败: {e}")
            
    def detect_errors(self) -> List[ErrorEvent]:
        """
        执行多维度错误检测
        
        Returns:
            检测到的错误事件列表
        """
        logger.info("开始多维度错误检测")
        detected_errors = []
        
        with self.lock:
            self.stats['total_detections'] += 1
        
        # 1. 运行时错误检测
        runtime_errors = self._detect_runtime_errors()
        detected_errors.extend(runtime_errors)
        
        # 2. 性能异常检测
        performance_errors = self._detect_performance_anomalies()
        detected_errors.extend(performance_errors)
        
        # 3. 逻辑错误检测
        logic_errors = self._detect_logic_errors()
        detected_errors.extend(logic_errors)
        
        # 4. 资源泄漏检测
        resource_errors = self._detect_resource_leaks()
        detected_errors.extend(resource_errors)
        
        # 5. 系统错误检测
        system_errors = self._detect_system_errors()
        detected_errors.extend(system_errors)
        
        # 更新当前错误列表
        self.current_errors = detected_errors
        
        # 记录到知识库
        for error in detected_errors:
            self._record_error(error)
        
        logger.info(f"检测到 {len(detected_errors)} 个错误")
        return detected_errors
    
