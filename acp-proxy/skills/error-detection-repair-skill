@dataclass
class RepairResult:
    """修复结果数据结构"""
    strategy_used: str
    success: bool
    duration: float
    verification_passed: bool
    error: Optional[str]
    metrics_before: Dict[str, float]
    metrics_after: Dict[str, float]


class ErrorDetectionRepairSkill:
    """错误检测与修复技能"""
    
    def __init__(self, knowledge_base_path: str = "error_knowledge_base.pkl"):
        self.logger = logging.getLogger(f"{__name__}.ErrorDetectionRepairSkill")
        self.knowledge_base_path = Path(knowledge_base_path)
        self.knowledge_base = self._load_knowledge_base()
        
        # 错误监控阈值
        self.thresholds = {
            "response_time": 2.0,  # 秒
            "cpu_usage": 80.0,     # 百分比
            "memory_usage": 85.0,  # 百分比
            "disk_usage": 90.0,    # 百分比
            "error_rate": 0.1      # 10%
        }
        
        # 机器学习模型
        self.error_classifier = DecisionTreeClassifier(max_depth=10)
        self.error_clusterer = KMeans(n_clusters=5, random_state=42)
        self.is_model_trained = False
        
        # 统计信息
        self.repair_statistics = {
            "total_repairs": 0,
            "successful_repairs": 0,
            "failed_repairs": 0,
            "avg_repair_time": 0.0,
            "repair_by_type": defaultdict(int),
            "success_by_type": defaultdict(int)
        }
        
        # 初始化模型
        self._initialize_models()
    
    def _load_knowledge_base(self) -> Dict[str, Any]:
        """加载错误知识库"""
        if self.knowledge_base_path.exists():
            try:
                with open(self.knowledge_base_path, 'rb') as f:
                    return pickle.load(f)
            except Exception as e:
                self.logger.warning(f"加载知识库失败: {e}")
        
        # 返回默认知识库结构
        return {
            "error_patterns": {},
            "repair_strategies": {},
            "historical_errors": [],
            "success_rates": {},
            "last_updated": datetime.now().isoformat()
        }
    
    def _save_knowledge_base(self):
        """保存错误知识库"""
        try:
            self.knowledge_base["last_updated"] = datetime.now().isoformat()
            with open(self.knowledge_base_path, 'wb') as f:
                pickle.dump(self.knowledge_base, f)
        except Exception as e:
            self.logger.error(f"保存知识库失败: {e}")
    
    def _initialize_models(self):
        """初始化机器学习模型"""
        # 如果有历史数据，训练模型
        if "historical_errors" in self.knowledge_base and len(self.knowledge_base["historical_errors"]) > 0:
            self._train_models()
    
    def _train_models(self):
        """训练错误分类模型"""
        try:
            historical_errors = self.knowledge_base["historical_errors"]
            if len(historical_errors) < 10:  # 最少需要10个样本
                return
            
            # 提取特征
            features = []
            labels = []
            
            for error in historical_errors[-100:]:  # 使用最近100个错误
                # 从错误中提取特征
                feature_vector = self._extract_features(error)
                features.append(feature_vector)
                labels.append(error.get("error_type", "unknown"))
            
            if len(features) > 0:
                # 训练分类器
                self.error_classifier.fit(features, labels)
                
                # 训练聚类器
                self.error_clusterer.fit(features)
                
                self.is_model_trained = True
                self.logger.info(f"模型训练完成，使用{len(features)}个样本")
        except Exception as e:
            self.logger.error(f"模型训练失败: {e}")
    
    def _extract_features(self, error_data: Dict[str, Any]) -> List[float]:
        """从错误数据中提取特征向量"""
        features = []
        
        # 时间特征
        if "timestamp" in error_data:
            features.append(error_data["timestamp"].hour / 24.0)
            features.append(error_data["timestamp"].weekday() / 7.0)
        
        # 性能指标特征
        perf_metrics = error_data.get("performance_metrics", {})
        features.append(perf_metrics.get("response_time", 0) / 10.0)
        features.append(perf_metrics.get("cpu_usage", 0) / 100.0)
        features.append(perf_metrics.get("memory_usage", 0) / 100.0)
        
        # 资源使用特征
        resource_usage = error_data.get("resource_usage", {})
        features.append(resource_usage.get("disk_usage", 0) / 100.0)
        features.append(resource_usage.get("network_usage", 0) / 100.0)
        
        # 错误堆栈特征（简化）
        stack_trace = error_data.get("stack_trace", "")
        features.append(min(len(stack_trace) / 1000.0, 1.0))
        
        # 确保特征维度一致
        while len(features) < 10:
            features.append(0.0)
        
        return features[:10]
    