logger = logging.getLogger(__name__)


class ErrorType(Enum):
    """错误类型枚举"""
    RUNTIME_ERROR = "runtime_error"
    PERFORMANCE_ANOMALY = "performance_anomaly"
    LOGIC_ERROR = "logic_error"
    RESOURCE_LEAK = "resource_leak"
    NETWORK_ERROR = "network_error"
    PERMISSION_ERROR = "permission_error"
    TIMEOUT_ERROR = "timeout_error"
    MEMORY_ERROR = "memory_error"
    UNKNOWN = "unknown"


class RepairStatus(Enum):
    """修复状态枚举"""
    PENDING = "pending"
    TESTING = "testing"
    DEPLOYING = "deploying"
    COMPLETED = "completed"
    FAILED = "failed"
    ROLLED_BACK = "rolled_back"


@dataclass
class ErrorPattern:
    """错误模式数据结构"""
    error_type: ErrorType
    pattern_signature: str
    frequency: int
    last_occurrence: datetime
    root_causes: List[str]
    repair_strategies: List[Dict[str, Any]]
    success_rate: float
    metadata: Dict[str, Any]


@dataclass
class ErrorLog:
    """错误日志数据结构"""
    error_id: str
    timestamp: datetime
    error_type: ErrorType
    message: str
    stack_trace: str
    system_metrics: Dict[str, Any]
    context: Dict[str, Any]
    severity: int  # 1-10
    resolved: bool = False
    resolution_time: Optional[float] = None


@dataclass
class RepairStrategy:
    """修复策略数据结构"""
    strategy_id: str
    error_type: ErrorType
    description: str
    steps: List[str]
    estimated_time: float  # 秒
    stability_score: float  # 0-1
    side_effects: List[str]
    rollback_plan: List[str]
    prerequisites: List[str]
    success_probability: float


class ErrorPatternLearner:
    """错误模式学习模块"""
    
    def __init__(self, model_path: Optional[str] = None):
        self.patterns: Dict[str, ErrorPattern] = {}
        self.error_history: List[ErrorLog] = []
        self.model = None
        self.scaler = StandardScaler() if HAS_SKLEARN else None
        self.model_path = model_path
        self._load_model()
    
    def _load_model(self):
        """加载预训练模型"""
        if self.model_path and Path(self.model_path).exists():
            try:
                with open(self.model_path, 'rb') as f:
                    data = pickle.load(f)
                    self.model = data.get('model')
                    self.scaler = data.get('scaler')
                    self.patterns = data.get('patterns', {})
                    logger.info(f"已加载错误模式模型，包含 {len(self.patterns)} 个模式")
            except Exception as e:
                logger.warning(f"加载模型失败: {e}")
                self._initialize_default_model()
    
    def _initialize_default_model(self):
        """初始化默认模型"""
        if HAS_SKLEARN:
            self.model = DecisionTreeClassifier(
                max_depth=10,
                min_samples_split=5,
                random_state=42
            )
            # 使用简化的聚类进行模式识别
            self.cluster_model = DBSCAN(eps=0.3, min_samples=2)
        
        # 初始化常见错误模式
        self._initialize_common_patterns()
    
