class MemoryType(Enum):
    """Memory type classification."""
    EPISODIC = "episodic"
    SEMANTIC = "semantic"
    PROCEDURAL = "procedural"
    EMOTIONAL = "emotional"


class ConsolidationStatus(Enum):
    """Memory consolidation status."""
    ACTIVE = "active"
    CONSOLIDATED = "consolidated"
    ARCHIVED = "archived"
    COMPRESSED = "compressed"


@dataclass
class Memory:
    """Individual memory unit with metadata."""
    id: str
    content: str
    content_embedding: Optional[np.ndarray] = None
    memory_type: MemoryType = MemoryType.SEMANTIC
    creation_time: datetime = field(default_factory=datetime.now)
    last_accessed: datetime = field(default_factory=datetime.now)
    access_count: int = 0
    emotional_intensity: float = 0.5
    information_value: float = 0.5
    importance_score: float = 0.0
    status: ConsolidationStatus = ConsolidationStatus.ACTIVE
    tags: List[str] = field(default_factory=list)
    source_session: str = ""
    metadata: Dict[str, Any] = field(default_factory=dict)
    related_memories: List[str] = field(default_factory=list)
    compression_level: int = 0
    
    def to_dict(self) -> Dict[str, Any]:
        """Serialize memory to dictionary (backward compatible)."""
        data = {
            'id': self.id,
            'content': self.content,
            'memory_type': self.memory_type.value,
            'creation_time': self.creation_time.isoformat(),
            'last_accessed': self.last_accessed.isoformat(),
            'access_count': self.access_count,
            'emotional_intensity': self.emotional_intensity,
            'information_value': self.information_value,
            'importance_score': self.importance_score,
            'status': self.status.value,
            'tags': self.tags,
            'source_session': self.source_session,
            'metadata': self.metadata,
            'related_memories': self.related_memories,
            'compression_level': self.compression_level,
        }
        if self.content_embedding is not None:
            data['content_embedding'] = self.content_embedding.tolist()
        return data
    
    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> 'Memory':
        """Deserialize memory from dictionary (backward compatible)."""
        embedding = None
        if 'content_embedding' in data and data['content_embedding']:
            embedding = np.array(data['content_embedding'])
        
        return cls(
            id=data.get('id', ''),
            content=data.get('content', ''),
            content_embedding=embedding,
            memory_type=MemoryType(data.get('memory_type', 'semantic')),
            creation_time=datetime.fromisoformat(data.get('creation_time', datetime.now().isoformat())),
            last_accessed=datetime.fromisoformat(data.get('last_accessed', datetime.now().isoformat())),
            access_count=data.get('access_count', 0),
            emotional_intensity=data.get('emotional_intensity', 0.5),
            information_value=data.get('information_value', 0.5),
            importance_score=data.get('importance_score', 0.0),
            status=ConsolidationStatus(data.get('status', 'active')),
            tags=data.get('tags', []),
            source_session=data.get('source_session', ''),
            metadata=data.get('metadata', {}),
            related_memories=data.get('related_memories', []),
            compression_level=data.get('compression_level', 0),
        )


@dataclass
class KnowledgeNode:
    """Node in the knowledge graph."""
    id: str
    label: str
    node_type: str = "concept"
    properties: Dict[str, Any] = field(default_factory=dict)
    memory_ids: List[str] = field(default_factory=list)
    created_at: datetime = field(default_factory=datetime.now)
    updated_at: datetime = field(default_factory=datetime.now)
    
    def to_dict(self) -> Dict[str, Any]:
        return {
            'id': self.id,
            'label': self.label,
            'node_type': self.node_type,
            'properties': self.properties,
            'memory_ids': self.memory_ids,
            'created_at': self.created_at.isoformat(),
            'updated_at': self.updated_at.isoformat(),
        }


@dataclass
class KnowledgeEdge:
    """Edge in the knowledge graph."""
    id: str
    source_id: str
    target_id: str
    relation_type: str = "related_to"
    weight: float = 1.0
    properties: Dict[str, Any] = field(default_factory=dict)
    created_at: datetime = field(default_factory=datetime.now)
    
    def to_dict(self) -> Dict[str, Any]:
        return {
            'id': self.id,
            'source_id': self.source_id,
            'target_id': self.target_id,
            'relation_type': self.relation_type,
            'weight': self.weight,
            'properties': self.properties,
            'created_at': self.created_at.isoformat(),
        }


@dataclass
class KnowledgeGraph:
    """Knowledge graph structure for organizing memories."""
    nodes: Dict[str, KnowledgeNode] = field(default_factory=dict)
    edges: Dict[str, KnowledgeEdge] = field(default_factory=dict)
    adjacency: Dict[str, Set[str]] = field(default_factory=lambda: defaultdict(set))
    
    def to_dict(self) -> Dict[str, Any]:
        return {
            'nodes': {k: v.to_dict() for k, v in self.nodes.items()},
            'edges': {k: v.to_dict() for k, v in self.edges.items()},
        }


# ============================================================================
# Embedding Utilities (lightweight, no external dependencies)
# ============================================================================

class SimpleEmbedder:
    """Simple text embedding using character-level and word-level features.
    For production use, replace with a proper sentence transformer."""
    
    def __init__(self, dim: int = 128):
        self.dim = dim
        self._vocab: Dict[str, int] = {}
    
    def encode(self, text: str) -> np.ndarray:
        """Generate a simple embedding vector for text."""
        # Normalize text
        text = text.lower().strip()
        words = text.split()
        
        # Create feature vector
        features = np.zeros(self.dim, dtype=np.float32)
        
        # Word-level features (hashed)
        for word in words:
            hash_val = int(hashlib.md5(word.encode()).hexdigest(), 16)
            idx = hash_val % self.dim
            features[idx] += 1.0
        
        # Character n-gram features
        for i in range(len(text) - 1):
            bigram = text[i:i+2]
            hash_val = int(hashlib.md5(bigram.encode()).hexdigest(), 16)
            idx = hash_val % self.dim
            features[idx] += 0.5
        
        # Normalize
        norm = np.linalg.norm(features)
        if norm > 0:
            features = features / norm
        
        return features
    
    def batch_encode(self, texts: List[str]) -> np.ndarray:
        """Encode multiple texts."""
        return np.array([self.encode(t) for t in texts])


