        self.similarity_threshold = 0.85
        self.importance_weights = {
            'access_frequency': 0.3,
            'emotion_intensity': 0.3,
            'information_value': 0.4
        }
        self.schedule_setup()
        
    def schedule_setup(self):
        schedule.every().sunday.at("23:00").do(self.consolidate_knowledge)
        
