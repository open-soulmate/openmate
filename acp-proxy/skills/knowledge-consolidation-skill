import datetime
import math
import uuid
from collections import defaultdict
from typing import Dict, List, Optional, Tuple, Any, Set
from dataclasses import dataclass, field
from enum import Enum
import numpy as np

# Constants
SEMANTIC_SIMILARITY_THRESHOLD = 0.85
IMPORTANCE_WEIGHTS = {
    'usage_frequency': 0.3,
    'emotional_intensity': 0.3,
    'information_value': 0.4
}
WEEKLY_REVIEW_DAY = 6  # Sunday (0=Monday, 6=Sunday)
WEEKLY_REVIEW_HOUR = 23  # 11 PM
MEMORY_COMPRESSION_THRESHOLD = 5


class MemoryType(Enum):
    EPISODIC = "episodic"
    SEMANTIC = "semantic"
    PROCEDURAL = "procedural"
    EMOTIONAL = "emotional"


@dataclass
class Memory:
    """Memory data structure"""
    id: str
    content: str
    timestamp: datetime.datetime
    memory_type: MemoryType
    emotional_intensity: float = 0.5  # 0.0 - 1.0
    information_value: float = 0.5    # 0.0 - 1.0
    usage_count: int = 0
    importance_score: float = 0.0
    embeddings: Optional[np.ndarray] = None
    tags: List[str] = field(default_factory=list)
    context: str = ""
    source_session: str = ""
    related_memories: List[str] = field(default_factory=list)
    
    def __post_init__(self):
        if self.importance_score == 0.0:
            self.importance_score = self.calculate_importance()
    
    def calculate_importance(self) -> float:
        """Calculate importance score based on weighted factors"""
        frequency_score = min(1.0, self.usage_count / 10.0)
        return (
            IMPORTANCE_WEIGHTS['usage_frequency'] * frequency_score +
            IMPORTANCE_WEIGHTS['emotional_intensity'] * self.emotional_intensity +
            IMPORTANCE_WEIGHTS['information_value'] * self.information_value
        )
    
    def update_importance(self):
        """Update importance score with current values"""
        self.importance_score = self.calculate_importance()
    
    def add_usage(self):
        """Increment usage count and update importance"""
        self.usage_count += 1
        self.update_importance()
    
    def to_dict(self) -> Dict[str, Any]:
        """Convert memory to dictionary for serialization"""
        return {
            'id': self.id,
            'content': self.content,
            'timestamp': self.timestamp.isoformat(),
            'memory_type': self.memory_type.value,
            'emotional_intensity': self.emotional_intensity,
            'information_value': self.information_value,
            'usage_count': self.usage_count,
            'importance_score': self.importance_score,
            'tags': self.tags,
            'context': self.context,
            'source_session': self.source_session,
            'related_memories': self.related_memories
        }
    
    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> 'Memory':
        """Create memory from dictionary"""
        memory = cls(
            id=data['id'],
            content=data['content'],
            timestamp=datetime.datetime.fromisoformat(data['timestamp']),
            memory_type=MemoryType(data['memory_type']),
            emotional_intensity=data.get('emotional_intensity', 0.5),
            information_value=data.get('information_value', 0.5),
            usage_count=data.get('usage_count', 0),
            importance_score=data.get('importance_score', 0.0),
            tags=data.get('tags', []),
            context=data.get('context', ''),
            source_session=data.get('source_session', ''),
            related_memories=data.get('related_memories', [])
        )
        return memory


@dataclass
class KnowledgeGraphNode:
    """Knowledge graph node"""
    id: str
    label: str
    node_type: str
    properties: Dict[str, Any] = field(default_factory=dict)
    memory_ids: Set[str] = field(default_factory=set)
    
    def __hash__(self):
        return hash(self.id)
    
    def __eq__(self, other):
        return isinstance(other, KnowledgeGraphNode) and self.id == other.id


@dataclass
class KnowledgeGraphEdge:
    """Knowledge graph edge"""
    id: str
    source_id: str
    target_id: str
    relationship: str
    weight: float = 1.0
    properties: Dict[str, Any] = field(default_factory=dict)
    
    def __hash__(self):
        return hash(self.id)
    
    def __eq__(self, other):
        return isinstance(other, KnowledgeGraphEdge) and self.id == other.id


