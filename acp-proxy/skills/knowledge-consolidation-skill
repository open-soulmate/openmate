@dataclass
class Memory:
    id: str
    content: str
    embedding: Optional[np.ndarray] = None
    timestamp: datetime = None
    emotion_score: float = 0.0
    frequency: int = 1
    importance_score: float = 0.0
    is_compressed: bool = False
    original_memories: List[str] = None
    topics: List[str] = None
    
    def to_dict(self) -> Dict[str, Any]:
        data = asdict(self)
        if self.embedding is not None:
            data['embedding'] = self.embedding.tolist()
        data['timestamp'] = self.timestamp.isoformat()
        if self.original_memories:
            data['original_memories'] = self.original_memories
        return data
    
    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> 'Memory':
        if 'embedding' in data and data['embedding'] is not None:
            data['embedding'] = np.array(data['embedding'])
        if 'timestamp' in data:
            data['timestamp'] = datetime.fromisoformat(data['timestamp'])
        return cls(**data)

class KnowledgeConsolidationSkill:
    def __init__(self, memory_storage: Any):
        self.storage = memory_storage
        self.graph = nx.DiGraph()
        self.vectorizer = TfidfVectorizer(max_features=1000)
        self.embedding_cache = {}
        
        # 配置参数
        self.similarity_threshold = 0.85
        self.importance_weights = {
            'frequency': 0.3,
            'emotion': 0.3,
            'value': 0.4
        }
        self.compression_threshold = 5
        self.max_memories_per_consolidation = 1000
        
        # 加载现有记忆到知识图谱
        self._load_existing_memories()
    
    def _load_existing_memories(self):
        """加载现有记忆到知识图谱"""
        try:
            memories = self.storage.query_all()
            for memory in memories:
                self._add_memory_to_graph(memory)
        except:
            pass
    
    def _generate_memory_id(self, content: str) -> str:
        """生成记忆ID"""
        hash_obj = hashlib.md5(content.encode())
        return hash_obj.hexdigest()[:12]
    
    def _calculate_embedding(self, text: str) -> np.ndarray:
        """计算文本的向量表示"""
        if text in self.embedding_cache:
            return self.embedding_cache[text]
        
        try:
            # 使用TF-IDF作为向量表示
            tfidf_matrix = self.vectorizer.fit_transform([text])
            embedding = tfidf_matrix.toarray()[0]
            self.embedding_cache[text] = embedding
            return embedding
