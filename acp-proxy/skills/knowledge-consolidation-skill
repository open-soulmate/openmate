class Memory:
    """记忆数据结构"""
    def __init__(self, 
                 content: str,
                 embedding: Optional[np.ndarray] = None,
                 metadata: Optional[Dict] = None):
        self.id = hashlib.md5(content.encode()).hexdigest()[:16]
        self.content = content
        self.embedding = embedding
        self.metadata = metadata or {}
        self.created_at = datetime.now()
        self.last_accessed = datetime.now()
        self.access_count = 0
        self.importance_score = 0.0
        self.is_compressed = False
        self.related_memories = []  # 关联的记忆ID
        
    def to_dict(self) -> Dict:
        """转换为字典格式，兼容现有存储格式"""
        return {
            'id': self.id,
            'content': self.content,
            'metadata': self.metadata,
            'created_at': self.created_at.isoformat(),
            'last_accessed': self.last_accessed.isoformat(),
            'access_count': self.access_count,
            'importance_score': self.importance_score,
            'is_compressed': self.is_compressed,
            'related_memories': self.related_memories
        }
    
    @classmethod
    def from_dict(cls, data: Dict) -> 'Memory':
        """从字典创建记忆，兼容旧格式"""
        memory = cls(content=data['content'], metadata=data.get('metadata', {}))
        memory.id = data.get('id', memory.id)
        memory.created_at = datetime.fromisoformat(data.get('created_at', datetime.now().isoformat()))
        memory.last_accessed = datetime.fromisoformat(data.get('last_accessed', datetime.now().isoformat()))
        memory.access_count = data.get('access_count', 0)
        memory.importance_score = data.get('importance_score', 0.0)
        memory.is_compressed = data.get('is_compressed', False)
        memory.related_memories = data.get('related_memories', [])
        return memory

class KnowledgeGraph:
    """知识图谱数据结构"""
    def __init__(self):
        self.nodes = {}  # {node_id: {'content': str, 'type': str, 'properties': dict}}
        self.edges = {}  # {edge_id: {'source': str, 'target': str, 'relation': str, 'weight': float}}
        self.adjacency_list = defaultdict(set)  # {node_id: set(edge_ids)}
        
    def add_node(self, node_id: str, content: str, node_type: str, properties: Optional[Dict] = None):
        """添加节点"""
        self.nodes[node_id] = {
            'content': content,
            'type': node_type,
            'properties': properties or {},
