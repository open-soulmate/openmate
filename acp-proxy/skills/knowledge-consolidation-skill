class Memory:
    """记忆数据结构"""
    def __init__(self, content: str, metadata: Optional[Dict] = None, memory_id: Optional[str] = None):
        self.id = memory_id or str(uuid.uuid4())
        self.content = content
        self.metadata = metadata or {}
        self.created_at = datetime.now()
        self.updated_at = datetime.now()
        self.access_count = 0
        self.last_accessed = None
        self.importance_score = 0.0
        self.embedding = None
        self.embedding_hash = None
        self.tags: Set[str] = set(metadata.get('tags', []))
        self.emotional_intensity: float = metadata.get('emotional_intensity', 0.5)
        self.information_value: float = metadata.get('information_value', 0.5)
        
    def to_dict(self) -> Dict:
        """转换为字典格式"""
        return {
            'id': self.id,
            'content': self.content,
            'metadata': self.metadata,
            'created_at': self.created_at.isoformat(),
            'updated_at': self.updated_at.isoformat(),
            'access_count': self.access_count,
            'last_accessed': self.last_accessed.isoformat() if self.last_accessed else None,
            'importance_score': self.importance_score,
            'tags': list(self.tags),
            'emotional_intensity': self.emotional_intensity,
            'information_value': self.information_value
        }
    
    @classmethod
    def from_dict(cls, data: Dict) -> 'Memory':
        """从字典创建记忆对象"""
        memory = cls(
            content=data['content'],
            metadata=data.get('metadata', {}),
            memory_id=data['id']
        )
        memory.created_at = datetime.fromisoformat(data['created_at'])
        memory.updated_at = datetime.fromisoformat(data['updated_at'])
        memory.access_count = data['access_count']
        memory.last_accessed = datetime.fromisoformat(data['last_accessed']) if data['last_accessed'] else None
        memory.importance_score = data['importance_score']
        memory.tags = set(data.get('tags', []))
        memory.emotional_intensity = data.get('emotional_intensity', 0.5)
        memory.information_value = data.get('information_value', 0.5)
        return memory

class KnowledgeGraphNode:
    """知识图谱节点"""
    def __init__(self, node_id: str, label: str, node_type: str = "memory", properties: Dict = None):
        self.id = node_id
        self.label = label
        self.type = node_type
        self.properties = properties or {}
        self.created_at = datetime.now()
        self.updated_at = datetime.now()

class KnowledgeGraphEdge:
    """知识图谱边"""
    def __init__(self, source_id: str, target_id: str, relation_type: str, weight: float = 1.0, properties: Dict = None):
        self.id = str(uuid.uuid4())
        self.source_id = source_id
        self.target_id = target_id
        self.relation_type = relation_type
        self.weight = weight
        self.properties = properties or {}
        self.created_at = datetime.now()

