class Memory:
    """记忆数据结构"""
    def __init__(self, memory_id: str, content: str, metadata: Dict[str, Any] = None):
        self.id = memory_id
        self.content = content
        self.metadata = metadata or {}
        self.embedding = None
        self.usage_count = self.metadata.get('usage_count', 0)
        self.emotion_intensity = self.metadata.get('emotion_intensity', 0.5)
        self.information_value = self.metadata.get('information_value', 0.5)
        self.timestamp = self.metadata.get('timestamp', datetime.now().isoformat())
        self.last_accessed = self.metadata.get('last_accessed', datetime.now().isoformat())
        self.importance_score = 0.0
        self.connections: Set[str] = set()
        
    def update_importance_score(self):
        """更新记忆重要性评分"""
        self.importance_score = (
            0.3 * min(1.0, self.usage_count / 10) +
            0.3 * self.emotion_intensity +
            0.4 * self.information_value
        )
        
    def to_dict(self) -> Dict[str, Any]:
        return {
            'id': self.id,
            'content': self.content,
            'metadata': {
                **self.metadata,
                'usage_count': self.usage_count,
                'emotion_intensity': self.emotion_intensity,
                'information_value': self.information_value,
                'timestamp': self.timestamp,
                'last_accessed': self.last_accessed,
                'connections': list(self.connections)
            },
            'embedding': self.embedding.tolist() if self.embedding is not None else None,
            'importance_score': self.importance_score
        }

