                  information_value: float = 0.5, tags: List[str] = None, 
                  source_session: str = "") -> str:
        """
        添加新记忆，自动执行去重和重要性评分
        """
        # 检查相似记忆（去重）
        similar_memory = self._find_similar_memory(content)
        if similar_memory:
            similar_memory.update_access()
            similar_memory.importance_score = self._calculate_importance(similar_memory)
            return similar_memory.memory_id
        
        # 创建新记忆
        memory_id = self._generate_memory_id(content)
        embedding = self._generate_embedding(content)
        now = datetime.now()
        
        new_memory = Memory(
            memory_id=memory_id,
            content=content,
            embedding=embedding,
            creation_time=now,
            last_access_time=now,
            access_count=1,
            emotion_intensity=emotion_intensity,
            information_value=information_value,
            tags=tags or [],
            source_session=source_session
        )
        
        new_memory.importance_score = self._calculate_importance(new_memory)
        self.memories[memory_id] = new_memory
        
        # 更新知识图谱
        self._update_knowledge_graph(new_memory)
        
        return memory_id
    
    def _find_similar_memory(self, content: str) -> Optional[Memory]:
        """查找相似记忆"""
        if not self.memories:
            return None
            
        query_embedding = self._generate_embedding(content)
        
        for memory in self.memories.values():
            similarity = cosine_similarity(
                query_embedding.reshape(1, -1),
                memory.embedding.reshape(1, -1)
            )[0][0]
            
            if similarity >= self.similarity_threshold:
                return memory
                
        return None
    
