@dataclass
class Memory:
    """记忆数据结构"""
    id: str
    content: str
    embedding: List[float]
    timestamp: datetime
    usage_count: int = 0
    emotional_intensity: float = 0.5
    information_value: float = 0.5
    importance_score: float = 0.0
    tags: List[str] = None
    related_memories: List[str] = None
    
    def __post_init__(self):
        if self.tags is None:
            self.tags = []
        if self.related_memories is None:
            self.related_memories = []

class KnowledgeConsolidationSkill:
    """知识巩固技能类"""
    
    def __init__(self):
        # 初始化模型
        self.model = SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2')
        
        # 记忆存储
        self.memories: Dict[str, Memory] = {}
        self.memory_embeddings: np.ndarray = None
        self.memory_ids: List[str] = []
        
        # 知识图谱
        self.knowledge_graph = nx.DiGraph()
        
        # 配置参数
        self.SIMILARITY_THRESHOLD = 0.85
        self.IMPORTANCE_WEIGHTS = {
            'usage_frequency': 0.3,
            'emotional_intensity': 0.3,
            'information_value': 0.4
        }
        self.COMPRESSION_THRESHOLD = 5  # 记忆压缩阈值
        
        # 性能监控
        self.performance_metrics = {
            'last_consolidation_time': None,
            'processed_memories_count': 0
        }
        
        # 加载现有记忆
        self._load_memories()
        
        # 启动定期回顾任务
        self._setup_scheduled_tasks()
    
    def _load_memories(self):
        """加载现有记忆"""
        try:
            with open('memories.json', 'r', encoding='utf-8') as f:
                data = json.load(f)
                for mem_data in data:
                    memory = Memory(
                        id=mem_data['id'],
                        content=mem_data['content'],
                        embedding=mem_data['embedding'],
                        timestamp=datetime.fromisoformat(mem_data['timestamp']),
                        usage_count=mem_data.get('usage_count', 0),
                        emotional_intensity=mem_data.get('emotional_intensity', 0.5),
                        information_value=mem_data.get('information_value', 0.5),
                        importance_score=mem_data.get('importance_score', 0.0),
                        tags=mem_data.get('tags', []),
                        related_memories=mem_data.get('related_memories', [])
                    )
                    self.memories[memory.id] = memory
        except FileNotFoundError:
            logger.info("未找到现有记忆文件，创建新存储")
    
    def _save_memories(self):
        """保存记忆到文件"""
        try:
            memory_list = []
            for memory in self.memories.values():
                mem_dict = asdict(memory)
                mem_dict['timestamp'] = mem_dict['timestamp'].isoformat()
                memory_list.append(mem_dict)
            
            with open('memories.json', 'w', encoding='utf-8') as f:
                json.dump(memory_list, f, ensure_ascii=False, indent=2)
        except Exception as e:
            logger.error(f"保存记忆失败: {e}")
    
    def _setup_scheduled_tasks(self):
        """设置定期任务"""
        # 每周日晚上执行记忆回顾
        schedule.every().sunday.at("23:00").do(self.consolidate_knowledge)
        
        # 启动定时任务线程
        import threading
        def run_scheduler():
            while True:
                schedule.run_pending()
                time.sleep(60)
        
        scheduler_thread = threading.Thread(target=run_scheduler, daemon=True)
        scheduler_thread.start()
    
    def _calculate_embedding(self, text: str) -> List[float]:
        """计算文本嵌入向量"""
        embedding = self.model.encode(text)
        return embedding.tolist()
    
    def _calculate_similarity(self, vec1: List[float], vec2: List[float]) -> float:
        """计算两个向量的余弦相似度"""
        vec1 = np.array(vec1).reshape(1, -1)
        vec2 = np.array(vec2).reshape(1, -1)
        return cosine_similarity(vec1, vec2)[0][0]
    
    def _calculate_importance_score(self, memory: Memory) -> float:
        """计算记忆重要性评分"""
        # 归一化各项指标（假设输入范围是0-1）
        score = (
            memory.usage_count * self.IMPORTANCE_WEIGHTS['usage_frequency'] +
            memory.emotional_intensity * self.IMPORTANCE_WEIGHTS['emotional_intensity'] +
            memory.information_value * self.IMPORTANCE_WEIGHTS['information_value']
        )
        return min(1.0, max(0.0, score))
    
    def _generate_memory_id(self, content: str) -> str:
        """生成记忆ID"""
        return hashlib.md5(content.encode()).hexdigest()[:16]
    
