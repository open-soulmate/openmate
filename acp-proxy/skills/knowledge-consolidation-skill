@dataclass
class Memory:
    memory_id: str
    content: str
    embedding: np.ndarray
    creation_time: datetime
    last_access_time: datetime
    access_count: int = 0
    emotion_intensity: float = 0.5
    information_value: float = 0.5
    importance_score: float = 0.0
    tags: List[str] = field(default_factory=list)
    source_session: str = ""
    related_memories: List[str] = field(default_factory=list)
    
    def update_access(self):
        self.access_count += 1
        self.last_access_time = datetime.now()

class KnowledgeGraph:
    def __init__(self):
        self.nodes: Dict[str, Dict] = {}  # node_id: {type, content, properties}
        self.edges: List[Dict] = []  # {from, to, relationship, weight}
        
    def add_node(self, node_id: str, node_type: str, content: str, properties: Dict = None):
        self.nodes[node_id] = {
            "type": node_type,
            "content": content,
            "properties": properties or {}
        }
        
    def add_edge(self, from_node: str, to_node: str, relationship: str, weight: float = 1.0):
        if from_node in self.nodes and to_node in self.nodes:
            self.edges.append({
                "from": from_node,
                "to": to_node,
                "relationship": relationship,
                "weight": weight
            })
            
    def update_node(self, node_id: str, updates: Dict):
        if node_id in self.nodes:
            self.nodes[node_id].update(updates)
            
    def query_node(self, node_id: str) -> Optional[Dict]:
        return self.nodes.get(node_id)
    
    def query_edges_from(self, node_id: str) -> List[Dict]:
        return [edge for edge in self.edges if edge["from"] == node_id]
    
    def get_graph_data(self) -> Dict:
        return {
            "nodes": list(self.nodes.values()),
            "edges": self.edges,
            "stats": {
                "total_nodes": len(self.nodes),
                "total_edges": len(self.edges),
                "node_types": self._count_node_types()
            }
        }
    
    def _count_node_types(self) -> Dict[str, int]:
        type_counts = defaultdict(int)
        for node_data in self.nodes.values():
            type_counts[node_data["type"]] += 1
        return dict(type_counts)

