class SandboxEnvironment:
    """安全沙箱环境，支持Python 3.8+代码执行"""
    
    def __init__(self, timeout: int = 30):
        self.timeout = timeout
        self.restricted_modules = {
            'os', 'sys', 'subprocess', 'shutil', 'socket', 'http',
            'urllib', 'requests', 'paramiko', 'ftplib', 'smtplib'
        }
        
    def validate_code(self, code: str) -> Tuple[bool, str]:
        """验证代码安全性"""
        try:
            tree = ast.parse(code)
            
            # 检查危险系统调用
            dangerous_calls = [
                'os.system', 'os.popen', 'subprocess.run', 'subprocess.call',
                'subprocess.Popen', 'exec', 'eval', 'compile',
                '__import__', 'open', 'file', 'input'
            ]
            
            for node in ast.walk(tree):
                if isinstance(node, ast.Call):
                    if isinstance(node.func, ast.Name):
                        if node.func.id in dangerous_calls:
                            return False, f"禁止调用: {node.func.id}"
                    elif isinstance(node.func, ast.Attribute):
                        if node.func.attr in ['system', 'popen', 'run', 'call']:
                            return False, f"禁止系统调用: {node.func.attr}"
            
            # 检查文件系统访问
            for node in ast.walk(tree):
                if isinstance(node, ast.Import):
                    for alias in node.names:
                        if alias.name in self.restricted_modules:
                            return False, f"禁止导入模块: {alias.name}"
                elif isinstance(node, ast.ImportFrom):
                    if node.module in self.restricted_modules:
                        return False, f"禁止从模块导入: {node.module}"
            
            return True, "代码安全检查通过"
        except SyntaxError as e:
            return False, f"语法错误: {str(e)}"
    
    def execute_code(self, code: str) -> Dict[str, Any]:
        """在沙箱中执行代码"""
        # 验证代码安全性
        is_safe, message = self.validate_code(code)
        if not is_safe:
            return {
                "success": False,
                "error": f"安全检查失败: {message}",
                "output": "",
                "execution_time": 0
            }
        
        # 创建临时目录作为隔离环境
        with tempfile.TemporaryDirectory() as temp_dir:
            script_path = os.path.join(temp_dir, "test_script.py")
            
            with open(script_path, 'w', encoding='utf-8') as f:
                f.write(code)
            
            start_time = time.time()
            
            try:
                # 使用subprocess在隔离环境中执行
                result = subprocess.run(
                    [sys.executable, script_path],
                    capture_output=True,
                    text=True,
                    timeout=self.timeout,
                    cwd=temp_dir,
                    env={"PATH": os.environ.get("PATH", "")}
                )
                
                execution_time = time.time() - start_time
                
                return {
                    "success": result.returncode == 0,
                    "output": result.stdout,
                    "error": result.stderr,
                    "execution_time": execution_time,
                    "return_code": result.returncode
                }
                
            except subprocess.TimeoutExpired:
                return {
                    "success": False,
                    "error": f"执行超时 (>{self.timeout}秒)",
                    "output": "",
                    "execution_time": self.timeout
                }
            except Exception as e:
                return {
                    "success": False,
                    "error": f"执行异常: {str(e)}",
                    "output": "",
                    "execution_time": time.time() - start_time
                }


class CodeGenerator:
    """基于目标的代码生成模块"""
    
    def __init__(self):
        self.target_templates = {
            ImprovementTarget.SKILL_ENHANCEMENT: self._enhance_skill_template,
            ImprovementTarget.PLUGIN_OPTIMIZATION: self._optimize_plugin_template,
            ImprovementTarget.TOOL_CREATION: self._create_tool_template
        }
    
    def decompose_target(self, target: str, target_type: ImprovementTarget) -> List[str]:
        """分解目标为子任务"""
        decomposition_map = {
            ImprovementTarget.SKILL_ENHANCEMENT: [
                "分析现有技能接口",
                "识别性能瓶颈",
                "设计优化方案",
                "实现优化代码",
                "编写测试用例"
            ],
            ImprovementTarget.PLUGIN_OPTIMIZATION: [
                "分析插件架构",
                "识别优化点",
                "重构核心逻辑",
                "改进错误处理",
                "优化资源使用"
            ],
            ImprovementTarget.TOOL_CREATION: [
                "需求分析",
                "接口设计",
                "核心算法实现",
                "错误处理机制",
                "使用示例编写"
            ]
        }
        return decomposition_map.get(target_type, ["分析目标", "设计方案", "实现代码"])
    
    def generate_pseudocode(self, target: str, target_type: ImprovementTarget) -> str:
        """生成伪代码"""
        pseudocode_templates = {
            ImprovementTarget.SKILL_ENHANCEMENT: f"""
