class SandboxEnvironment:
    """Safe execution environment for Python code"""
    
    def __init__(self, base_dir: str = None):
        self.base_dir = base_dir or tempfile.mkdtemp(prefix="acp_sandbox_")
        self.allowed_modules = {
            'os', 'sys', 'math', 'json', 'collections', 'itertools',
            'functools', 're', 'datetime', 'pathlib', 'logging',
            'typing', 'dataclasses', 'hashlib', 'copy', 'pprint'
        }
        self.max_execution_time = 30  # seconds
        self.max_memory_mb = 512  # MB
        
    def _validate_code(self, code: str) -> Tuple[bool, List[str]]:
        """Validate code for safety violations"""
        warnings = []
        
        # Check for dangerous imports
        import_pattern = r"import\s+(\w+)|from\s+(\w+)\s+import"
        matches = re.findall(import_pattern, code)
        
        for match in matches:
            module = match[0] or match[1]
            if module not in self.allowed_modules and not module.startswith('.'):
                warnings.append(f"Potentially unsafe import: {module}")
        
        # Check for dangerous functions
        dangerous_calls = [
            'eval', 'exec', 'compile', '__import__', 'open', 'file',
            'subprocess', 'os.system', 'os.popen', 'os.exec*',
            'shutil.rmtree', 'shutil.copytree'
        ]
        
        for call in dangerous_calls:
            if call in code:
                warnings.append(f"Potentially dangerous call: {call}")
        
        # Check for file operations outside sandbox
        if 'open(' in code and 'base_dir' not in code:
            warnings.append("File operations without sandbox path")
        
        return len(warnings) == 0, warnings
    
    def execute(self, code: str, timeout: int = None) -> ExecutionResult:
        """Execute code in sandbox"""
        timeout = timeout or self.max_execution_time
        start_time = time.time()
        
        # Create temporary execution file
        exec_file = os.path.join(self.base_dir, "exec_script.py")
        
        # Wrap code with safety imports and sandbox setup
        wrapped_code = f"""
import sys
import os
import tempfile
import resource

# Set resource limits
def set_limits():
    # Memory limit (in bytes)
    memory_limit = {self.max_memory_mb * 1024 * 1024}
    try:
        resource.setrlimit(resource.RLIMIT_AS, (memory_limit, memory_limit))
    except:
        pass
    
    # CPU time limit
    resource.setrlimit(resource.RLIMIT_CPU, ({timeout}, {timeout}))

set_limits()

# Create isolated environment
sandbox_dir = "{self.base_dir}"
os.chdir(sandbox_dir)

# Safe input/output
import io
old_stdout = sys.stdout
old_stderr = sys.stderr
sys.stdout = io.StringIO()
sys.stderr = io.StringIO()

try:
    {code}
    
    # Get output
    stdout_output = sys.stdout.getvalue()
    stderr_output = sys.stderr.getvalue()
    
    # Write results to file
    with open(os.path.join(sandbox_dir, "execution_result.json"), "w") as f:
        json.dump({{
            "success": True,
            "stdout": stdout_output,
            "stderr": stderr_output,
            "exit_code": 0
        }}, f)
        
except Exception as e:
    stderr_output = sys.stderr.getvalue()
    stderr_output += f"\\nException: {{str(e)}}"
    
    with open(os.path.join(sandbox_dir, "execution_result.json"), "w") as f:
        json.dump({{
            "success": False,
            "stdout": sys.stdout.getvalue(),
            "stderr": stderr_output,
            "exit_code": 1
        }}, f)

finally:
    sys.stdout = old_stdout
    sys.stderr = old_stderr
"""
        
        try:
            # Validate code
            is_safe, warnings = self._validate_code(code)
            if not is_safe:
                return ExecutionResult(
                    success=False,
                    stdout="",
                    stderr="Code validation failed: " + "; ".join(warnings),
                    exit_code=-1,
                    execution_time=0.0,
                    memory_usage=0.0,
                    warnings=warnings
                )
            
            # Write code to file
            with open(exec_file, 'w') as f:
                f.write(wrapped_code)
            
            # Execute in subprocess with limits
            process = subprocess.Popen(
                [sys.executable, exec_file],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                cwd=self.base_dir,
                preexec_fn=lambda: os.setsid() if hasattr(os, 'setsid') else None
            )
            
            try: