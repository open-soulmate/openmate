class SandboxEnvironment:
    """安全沙箱环境，支持Python代码的测试执行"""

    def __init__(self, timeout: int = 30, max_memory_mb: int = 512):
        self.timeout = timeout
        self.max_memory_mb = max_memory_mb
        self.temp_dir = tempfile.mkdtemp(prefix="sandbox_")
        self.sandbox_config = {
            "allowed_modules": [
                "json", "math", "datetime", "re", "os.path",
                "pathlib", "collections", "itertools", "functools",
                "typing", "abc", "copy", "pickle", "base64",
                "hashlib", "hmac", "secrets", "statistics", "random",
                "decimal", "fractions", "cmath", "operator", "string",
                "textwrap", "unicodedata", "struct", "codecs", "io"
            ],
            "blocked_modules": [
                "subprocess", "shutil", "sys", "os", "socket",
                "http", "urllib", "requests", "multiprocessing",
                "threading", "ctypes", "importlib", "code", "compile",
                "eval", "exec", "globals", "locals", "vars", "dir",
                "hasattr", "getattr", "setattr", "delattr", "classmethod",
                "staticmethod", "property", "super", "object", "type"
            ],
            "blocked_functions": [
                "open", "file", "execfile", "compile", "eval",
                "exec", "__import__", "globals", "locals", "vars",
                "dir", "hasattr", "getattr", "setattr", "delattr"
            ]
        }

    def __del__(self):
        """清理临时目录"""
        try:
            shutil.rmtree(self.temp_dir, ignore_errors=True)
        except:
            pass

    def _create_restricted_script(self, code: str) -> str:
        """创建受限的执行脚本"""
        restricted_script = f"""
import sys
import os
import time
import psutil
import resource

# Set resource limits
resource.setrlimit(resource.RLIMIT_AS, ({self.max_memory_mb} * 1024 * 1024, -1))
resource.setrlimit(resource.RLIMIT_CPU, ({self.timeout}, {self.timeout + 5}))

# Remove dangerous modules
dangerous_modules = {self.sandbox_config['blocked_modules']}
for module in dangerous_modules:
    if module in sys.modules:
        del sys.modules[module]
        sys.modules[module] = None

# Override dangerous functions
original_open = builtins.open if hasattr(builtins, 'open') else None
def safe_open(*args, **kwargs):
    raise PermissionError("File operations not allowed in sandbox")
builtins.open = safe_open

# Execute the code in restricted environment
try:
    exec('''{code.replace("'", "\\'").replace("\\", "\\\\")}''')
except Exception as e:
    print(f"Error: {{type(e).__name__}}: {{e}}")
    raise
"""
        return restricted_script

    def execute_in_sandbox(self, code: str) -> ExecutionResult:
        """在沙箱环境中执行代码"""
        start_time = time.time()
        start_memory = psutil.Process().memory_info().rss / 1024 / 1024
        
        # Create temporary script
        script_path = os.path.join(self.temp_dir, f"script_{hashlib.md5(code.encode()).hexdigest()}.py")
        restricted_code = self._create_restricted_script(code)
        
        try:
            with open(script_path, 'w') as f:
                f.write(restricted_code)
            
            # Execute with resource limits
            process = subprocess.Popen(
                [sys.executable, script_path],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                cwd=self.temp_dir,
                env={},
                preexec_fn=os.setsid
            )
            
            try:
                stdout, stderr = process.communicate(timeout=self.timeout)
                execution_time = time.time() - start_time
                end_memory = psutil.Process().memory_info().rss / 1024 / 1024
                cpu_usage = psutil.cpu_percent(interval=0.1)
                
                return ExecutionResult(
                    success=process.returncode == 0,
                    output=stdout.decode('utf-8', errors='replace'),
                    error=stderr.decode('utf-8', errors='replace') if process.returncode != 0 else None,
                    execution_time=execution_time,
                    memory_usage=end_memory - start_memory,
                    cpu_usage=cpu_usage,
                    exit_code=process.returncode
                )
                
            except subprocess.TimeoutExpired:
                # Terminate process and its children
                os.killpg(os.getpgid(process.pid), signal.SIGTERM)
                process.kill()
                process.wait()
                
                return ExecutionResult(
                    success=False,
                    output="",
                    error=f"Execution timed out after {self.timeout} seconds",
                    execution_time=self.timeout,
                    memory_usage=0,
                    cpu_usage=0,
                    exit_code=-1
                )
                
        except Exception as e:
            return ExecutionResult(
                success=False,
                output="",
                error=str(e),
                execution_time=time.time() - start_time,
                memory_usage=0,
                cpu_usage=0,
                exit_code=-1
            )
        finally:
            # Cleanup
            if os.path.exists(script_path):
                os.remove(script_path)

