class RiskLevel(Enum):
    LOW = "low"
    MEDIUM = "medium"
    HIGH = "high"
    CRITICAL = "critical"

class TargetType(Enum):
    SKILL_ENHANCEMENT = "skill_enhancement"
    PLUGIN_OPTIMIZATION = "plugin_optimization"
    TOOL_CREATION = "tool_creation"

@dataclass
class CodeModification:
    id: str
    target_type: TargetType
    target_description: str
    original_code: str
    modified_code: str
    file_path: str
    created_at: datetime
    status: str = "pending"
    risk_assessment: Optional[Dict] = None
    test_results: Optional[Dict] = None
    deployed_at: Optional[datetime] = None

@dataclass
class SandBoxResult:
    success: bool
    output: str
    error: Optional[str] = None
    execution_time: float = 0.0
    memory_usage: float = 0.0
    cpu_usage: float = 0.0
    exit_code: int = 0

@dataclass
class RiskAssessment:
    risk_level: RiskLevel
    system_calls: List[str]
    performance_impact: float
    compatibility_issues: List[str]
    security_score: int
    recommendations: List[str]

class SelfProgrammingExecutorSkill:
    def __init__(self, workspace_dir: str, config: Dict[str, Any] = None):
        self.workspace_dir = workspace_dir
        self.config = config or {}
        self.modification_history: List[CodeModification] = []
        self.git_repo = None
        self.logger = self._setup_logging()
        self.sandbox_config = {
            'python_version': '3.8+',
            'timeout': 30,
            'memory_limit': 512 * 1024 * 1024,  # 512MB
            'cpu_limit': 30,  # seconds
            'allowed_imports': ['json', 'math', 'datetime', 'typing', 'collections', 'copy'],
            'blocked_imports': ['os', 'sys', 'subprocess', 'socket', 'http', 'urllib', 'shutil']
        }
        self._initialize_git()
        
    def _setup_logging(self) -> logging.Logger:
        logger = logging.getLogger('SelfProgrammingExecutor')
        logger.setLevel(logging.INFO)
        handler = logging.FileHandler(os.path.join(self.workspace_dir, 'self_programming.log'))
        formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
        handler.setFormatter(formatter)
        logger.addHandler(handler)
        return logger
    
    def _initialize_git(self):
        try:
            self.git_repo = git.Repo(self.workspace_dir)
            self.logger.info(f"Git repository initialized at {self.workspace_dir}")
        except git.InvalidGitRepositoryError:
            self.git_repo = git.Repo.init(self.workspace_dir)
            self.logger.info(f"Created new git repository at {self.workspace_dir}")
    
    def generate_code_improvement(self, target: Dict[str, Any]) -> CodeModification:
        """生成代码改进方案"""
        target_type = TargetType(target.get('type', 'skill_enhancement'))
        target_description = target.get('description', '')
        
        # 目标分解
        sub_targets = self._decompose_target(target_type, target_description)
        
        # 伪代码生成
        pseudocode = self._generate_pseudocode(sub_targets)
        
        # 完整代码生成
        code_structure = self._generate_code_structure(pseudocode, target_type)
        
        # 创建修改记录
        modification_id = hashlib.md5(f"{target_description}{datetime.now()}".encode()).hexdigest()[:12]
        
        modification = CodeModification(
            id=modification_id,
            target_type=target_type,
            target_description=target_description,
            original_code=self._get_current_code(target.get('file_path', '')),
            modified_code=code_structure,
            file_path=target.get('file_path', ''),
            created_at=datetime.now()
        )
        
        self.modification_history.append(modification)
        self.logger.info(f"Generated code improvement: {modification_id}")
        
        return modification
    
    def execute_in_sandbox(self, code: str) -> SandBoxResult:
        """在沙箱环境中执行代码"""
        start_time = time.time()
        
        # 创建临时目录
        sandbox_dir = tempfile.mkdtemp(prefix='sandbox_')
        
        try:
            # 创建执行文件
            code_file = os.path.join(sandbox_dir, 'test_code.py')
            with open(code_file, 'w') as f:
                f.write(code)
            
            # 执行代码
            process = subprocess.Popen(
                [sys.executable, code_file],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                cwd=sandbox_dir,
                env=self._create_sandbox_env()
            )
            
            # 设置资源限制
            self._set_resource_limits()
            
            # 等待执行完成
            stdout, stderr = process.communicate(timeout=self.sandbox_config['timeout'])
            
            execution_time = time.time() - start_time
            
            return SandBoxResult(
                success=process.returncode == 0,
                output=stdout.decode('utf-8', errors='ignore'),
                error=stderr.decode('utf-8', errors='ignore'),
                execution_time=execution_time,
                memory_usage=self._get_memory_usage(process.pid),
                cpu_usage=self._get_cpu_usage(process.pid),
                exit_code=process.returncode
            )
            
        except subprocess.TimeoutExpired:
            process.kill()
            return SandBoxResult(
                success=False,
                output="",
                error="Execution timeout exceeded",
                execution_time=time.time() - start_time
            )
        except Exception as e:
            return SandBoxResult(
                success=False,
                output="",
                error=str(e),
                execution_time=time.time() - start_time
            )
        finally:
            # 清理沙箱
            shutil.rmtree(sandbox_dir, ignore_errors=True)
    
    def assess_risk(self, code: str) -> RiskAssessment:
        """评估代码风险"""
        tree = ast.parse(code)
        
        system_calls = self._extract_system_calls(tree)
        performance_impact = self._estimate_performance_impact(tree)
        compatibility_issues = self._check_compatibility(tree)
        security_score = self._calculate_security_score(system_calls, compatibility_issues)
        
        risk_level = self._determine_risk_level(security_score)