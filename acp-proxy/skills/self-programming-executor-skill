class SecuritySandbox:
    """Isolated sandbox for safe code execution"""
    
    def __init__(self):
        self.temp_dir = tempfile.mkdtemp()
        self.allowed_modules = {
            'math', 'json', 'datetime', 'time', 'typing', 'pathlib',
            'os', 'sys', 'copy', 'itertools', 'functools', 'collections',
            'random', 'hashlib', 'base64', 're', 'uuid', 'ast'
        }
        self.blocked_modules = {'subprocess', 'shutil', 'socket', 'http', 'urllib'}
        self.max_execution_time = 30
        self.max_memory_mb = 100
        
    def validate_code(self, code: str) -> Tuple[bool, List[str]]:
        """Validate code for safety before execution"""
        issues = []
        
        try:
            tree = ast.parse(code)
        except SyntaxError as e:
            return False, [f"Syntax error: {e}"]
        
        for node in ast.walk(tree):
            # Check for system calls
            if isinstance(node, ast.Call):
                if isinstance(node.func, ast.Attribute):
                    if node.func.attr in ['system', 'popen', 'exec', 'eval']:
                        issues.append(f"System call detected: {node.func.attr}")
                elif isinstance(node.func, ast.Name):
                    if node.func.id in ['eval', 'exec', 'compile']:
                        issues.append(f"Potentially dangerous function: {node.func.id}")
            
            # Check for dangerous imports
            if isinstance(node, ast.Import):
                for alias in node.names:
                    module = alias.name.split('.')[0]
                    if module in self.blocked_modules:
                        issues.append(f"Blocked module import: {module}")
            
            if isinstance(node, ast.ImportFrom):
                module = node.module.split('.')[0] if node.module else ""
                if module in self.blocked_modules:
                    issues.append(f"Blocked module import: {module}")
        
        return len(issues) == 0, issues
    
    def execute(self, code: str, timeout: Optional[int] = None) -> ExecutionResult:
        """Execute code in sandbox with timeout and memory limits"""
        start_time = time.time()
        timeout = timeout or self.max_execution_time
        
        # Create execution environment
        exec_globals = {'__builtins__': self._get_safe_builtins()}
        exec_locals = {}
        
        try:
            # Validate code first
            is_safe, issues = self.validate_code(code)
            if not is_safe:
                return ExecutionResult(
                    success=False,
                    output="",
                    error=f"Security validation failed: {', '.join(issues)}",
                    execution_time=time.time() - start_time,
                    memory_usage=None,
                    risk_assessment={"security": "high", "issues": issues}
                )
            
            # Execute with timeout
            result = self._execute_with_timeout(code, exec_globals, exec_locals, timeout)
            
            return ExecutionResult(
                success=result['success'],
                output=str(result.get('output', '')),
                error=result.get('error'),
                execution_time=time.time() - start_time,
                memory_usage=self._get_memory_usage(),
                risk_assessment=self._assess_execution_risk(code)
            )
            
        except Exception as e:
            return ExecutionResult(
                success=False,
                output="",
                error=str(e),
                execution_time=time.time() - start_time,
                memory_usage=None,
                risk_assessment={"error": str(e)}
            )
    
    def _execute_with_timeout(self, code: str, globals_dict: dict, 
                            locals_dict: dict, timeout: int) -> dict:
        """Execute code with timeout using threading"""
        result = {'success': False, 'output': '', 'error': None}
        
        def target():
            try:
                exec(code, globals_dict, locals_dict)
                if 'result' in locals_dict:
                    result['output'] = locals_dict['result']
                result['success'] = True
            except Exception as e:
                result['error'] = str(e)
        
        thread = threading.Thread(target=target)
        thread.start()
        thread.join(timeout)
        
        if thread.is_alive():
            # Timeout occurred
            thread.join(0)  # Let it clean up
            result['error'] = "Execution timeout"
            result['success'] = False
        
        return result
    
