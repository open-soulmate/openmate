# acp-proxy/skills/self-programming-executor-skill/__init__.py

from .sandbox import CodeSandbox
from .code_generator import CodeGenerator
from .risk_assessor import RiskAssessor
from .improvement_loop import ImprovementLoop
from .version_control import VersionControl
from .rollback_manager import RollbackManager
from .logger import SelfProgrammingLogger

class SelfProgrammingExecutorSkill:
    """自我编程执行技能"""
    
    def __init__(self, workspace_path: str = "/tmp/self_programming"):
        self.workspace_path = workspace_path
        self.logger = SelfProgrammingLogger(workspace_path)
        self.sandbox = CodeSandbox(workspace_path)
        self.code_generator = CodeGenerator()
        self.risk_assessor = RiskAssessor()
        self.version_control = VersionControl(workspace_path)
        self.rollback_manager = RollbackManager(workspace_path)
        self.improvement_loop = ImprovementLoop(
            sandbox=self.sandbox,
            code_generator=self.code_generator,
            risk_assessor=self.risk_assessor,
            version_control=self.version_control,
            rollback_manager=self.rollback_manager,
            logger=self.logger
        )
        
        # 初始化技能目录结构
        self._init_skill_directory()
    
    def _init_skill_directory(self):
        """初始化技能目录结构"""
        import os
        directories = [
            self.workspace_path,
            os.path.join(self.workspace_path, "temp"),
            os.path.join(self.workspace_path, "versions"),
            os.path.join(self.workspace_path, "logs"),
            os.path.join(self.workspace_path, "backups")
        ]
        
        for directory in directories:
            os.makedirs(directory, exist_ok=True)
    
    def generate_code_improvement(self, target: str, target_type: str = "skill_enhancement") -> dict:
        """
        生成代码改进方案
        
        参数:
            target: 改进目标描述
            target_type: 目标类型 - skill_enhancement/plugin_optimization/tool_creation
            
        返回:
            改进方案详情
        """
        try:
            self.logger.log_action("generate_improvement", {
                "target": target,
                "target_type": target_type
            })
            
            # 生成代码改进方案
            improvement_plan = self.code_generator.generate_improvement(target, target_type)
            
            # 进行风险评估
            risk_assessment = self.assess_risk(improvement_plan["code"])
            improvement_plan["risk_assessment"] = risk_assessment
            
            self.logger.log_action("improvement_generated", {
                "target": target,
                "code_lines": len(improvement_plan["code"].split("\n")),
                "risk_level": risk_assessment["risk_level"]
            })
            
            return improvement_plan
            
        except Exception as e:
            self.logger.log_error("generate_improvement_failed", str(e))
            raise
    
    def execute_in_sandbox(self, code: str, timeout: int = 30) -> dict:
        """
        在沙箱中执行代码
        
        参数:
            code: 要执行的Python代码
            timeout: 执行超时时间(秒)
            
        返回:
            执行结果详情
        """
        try:
            self.logger.log_action("execute_in_sandbox", {
                "code_lines": len(code.split("\n")),
                "timeout": timeout
            })
            
            # 在沙箱中执行代码
            execution_result = self.sandbox.execute(code, timeout)
            
            self.logger.log_action("sandbox_execution_completed", {
                "success": execution_result["success"],
                "execution_time": execution_result.get("execution_time", 0)
            })
            
            return execution_result
            
        except Exception as e:
            self.logger.log_error("sandbox_execution_failed", str(e))
            raise
    
    def assess_risk(self, code: str) -> dict:
        """
        评估代码风险
        
        参数:
            code: 要评估的Python代码
            
        返回:
            风险评估详情
        """
        try:
            self.logger.log_action("assess_risk", {
                "code_lines": len(code.split("\n"))
            })
            
            # 进行风险评估
            risk_assessment = self.risk_assessor.assess(code)
            
            self.logger.log_action("risk_assessment_completed", {
                "risk_level": risk_assessment["risk_level"],
                "risk_score": risk_assessment["risk_score"],
                "issues_found": len(risk_assessment.get("issues", []))
            })
            
            return risk_assessment
            
        except Exception as e:
            self.logger.log_error("risk_assessment_failed", str(e))
            raise
    
    def deploy_change(self, code: str, commit_message: str, auto_rollback: bool = True) -> dict:
        """
        部署代码更改
        
        参数:
            code: 要部署的代码
            commit_message: 提交信息
            auto_rollback: 是否在失败时自动回滚
            
        返回:
            部署结果详情
        """
        try:
            self.logger.log_action("deploy_change", {
                "code_lines": len(code.split("\n")),
                "commit_message": commit_message,
                "auto_rollback": auto_rollback
            })
            
            # 创建备份点
            backup_id = self.rollback_manager.create_backup()
            
            # 在沙箱中测试代码
            test_result = self.execute_in_sandbox(code)
            
            if not test_result["success"]:
                if auto_rollback:
                    self.logger.log_action("auto_rollback_triggered", {
                        "backup_id": backup_id,
                        "reason": "sandbox_test_failed"
                    })
                    self.rollback_manager.rollback(backup_id)
                    
                return {
                    "success": False,
                    "error": "沙箱测试失败",
                    "test_result": test_result,
                    "rolled_back": auto_rollback
                }
            
            # 版本控制提交
            commit_result = self.version_control.commit_code(code, commit_message)
            
            self.logger.log_action("deployment_completed", {
                "commit_id": commit_result.get("commit_id"),
                "success": True
            })
            
            return {
                "success": True,
                "commit_result": commit_result,
                "test_result": test_result,
                "backup_id": backup_id
            }
            
        except Exception as e:
