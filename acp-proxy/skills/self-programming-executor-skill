class SandboxEnvironment:
    """Sandbox environment for safe code execution"""
    
    def __init__(self, temp_dir: Optional[str] = None):
        self.temp_dir = temp_dir or tempfile.mkdtemp(prefix="self_programming_")
        self.restricted_imports = [
            'os', 'sys', 'subprocess', 'shutil', 'pathlib',
            'socket', 'http', 'urllib', 'ftplib', 'smtplib'
        ]
        self.allowed_modules = [
            'math', 'datetime', 'json', 'collections', 'itertools',
            'functools', 'typing', 'dataclasses', 'logging'
        ]
        
    def validate_code(self, code: str) -> Tuple[bool, List[str]]:
        """Validate code for safety"""
        issues = []
        
        try:
            tree = ast.parse(code)
        except SyntaxError as e:
            return False, [f"Syntax error: {e}"]
        
        # Check for dangerous system calls
        for node in ast.walk(tree):
            if isinstance(node, ast.Call):
                if isinstance(node.func, ast.Attribute):
                    if node.func.attr in ['system', 'popen', 'exec', 'eval']:
                        issues.append(f"Dangerous function call: {node.func.attr}")
                elif isinstance(node.func, ast.Name):
                    if node.func.id in ['exec', 'eval', 'compile']:
                        issues.append(f"Dangerous function call: {node.func.id}")
            
            # Check for file operations
            if isinstance(node, ast.Name) and node.id in ['open', 'file']:
                issues.append("File operation detected")
            
            # Check for network operations
            if isinstance(node, ast.Import):
                for alias in node.names:
                    if alias.name.split('.')[0] in self.restricted_imports:
                        issues.append(f"Restricted import: {alias.name}")
        
        return len(issues) == 0, issues
    
    @contextmanager
    def execution_context(self):
        """Create isolated execution context"""
        original_dir = os.getcwd()
        os.chdir(self.temp_dir)
        
        # Create restricted Python environment
        restricted_globals = {
            '__builtins__': {
                'print': print,
                'range': range,
                'len': len,
                'type': type,
                'isinstance': isinstance,
                'int': int,
                'float': float,
                'str': str,
                'bool': bool,
                'list': list,
                'dict': dict,
                'tuple': tuple,
                'set': set,
                'map': map,
                'filter': filter,
                'zip': zip,
                'sum': sum,
                'min': min,
                'max': max,
                'sorted': sorted,
                'reversed': reversed,
                'enumerate': enumerate,
                'any': any,
                'all': all,
                'abs': abs,
                'round': round,
                'pow': pow,
                'divmod': divmod,
                'hash': hash,
                'id': id,
                'chr': chr,
                'ord': ord,
                'hex': hex,
                'oct': oct,
                'bin': bin,
            }
        }
        
        try:
            yield restricted_globals
        finally:
            os.chdir(original_dir)
    
    def execute(self, code: str, timeout: int = 30) -> SandboxResult:
        """Execute code in sandbox environment"""
        start_time = time.time()
        
        # Validate code first
        is_valid, issues = self.validate_code(code)
        if not is_valid:
            return SandboxResult(
                success=False,
                output="",
                error=f"Code validation failed: {'; '.join(issues)}",
                execution_time=time.time() - start_time
            )
        
        try:
            with self.execution_context() as globals_dict:
                # Add safe imports
                for module_name in self.allowed_modules:
                    try:
                        module = importlib.import_module(module_name)
                        globals_dict[module_name] = module
                    except ImportError:
                        pass
                
                # Compile and execute
                compiled_code = compile(code, '<sandbox>', 'exec')
                exec(compiled_code, globals_dict)
                
                return SandboxResult(
                    success=True,
                    output="Execution completed successfully",
                    execution_time=time.time() - start_time
                )
                
        except Exception as e:
            return SandboxResult(
                success=False,
                output="",
                error=str(e),
                execution_time=time.time() - start_time
            )
    
    def cleanup(self):
        """Clean up sandbox environment"""
        if os.path.exists(self.temp_dir):
            shutil.rmtree(self.temp_dir, ignore_errors=True)


