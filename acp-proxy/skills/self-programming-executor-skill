class TargetType(Enum):
    """目标类型枚举"""
    SKILL_ENHANCEMENT = "skill_enhancement"
    PLUGIN_OPTIMIZATION = "plugin_optimization"
    TOOL_CREATION = "tool_creation"


@dataclass
class ImprovementTarget:
    """改进目标数据结构"""
    target_id: str
    target_type: TargetType
    description: str
    requirements: Dict[str, Any]
    priority: int = 5
    created_at: datetime = None
    
    def __post_init__(self):
        if self.created_at is None:
            self.created_at = datetime.now()


@dataclass
class CodeModification:
    """代码修改记录"""
    modification_id: str
    target_id: str
    original_code: str
    modified_code: str
    file_path: str
    timestamp: datetime
    status: str  # 'pending', 'tested', 'deployed', 'failed', 'rolled_back'
    risk_assessment: Dict[str, Any] = None


@dataclass
class ExecutionResult:
    """执行结果"""
    success: bool
    output: str
    error: str
    execution_time: float
    memory_usage: Optional[float] = None
    return_value: Any = None


class SandboxEnvironment:
    """代码沙箱环境"""
    
    def __init__(self, timeout: int = 30, memory_limit_mb: int = 128):
        self.timeout = timeout
        self.memory_limit_mb = memory_limit_mb
        self.temp_dir = tempfile.mkdtemp(prefix="code_sandbox_")
        self._setup_restrictions()
        
    def _setup_restrictions(self):
        """设置沙箱限制"""
        # 禁止的系统调用
        self.forbidden_calls = {
            'os.system', 'os.popen', 'os.exec*', 'os.spawn*',
            'subprocess.run', 'subprocess.call', 'subprocess.Popen',
            'shutil.rmtree', 'shutil.copytree',
            'open', 'file',  # 限制文件操作
        }
        
        # 允许的安全模块
        self.allowed_modules = {
            'math', 'random', 'datetime', 'json', 'csv', 'hashlib',
            'collections', 'itertools', 'functools', 'typing',
            're', 'string', 'textwrap', 'unicodedata'