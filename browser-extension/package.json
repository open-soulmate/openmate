{
  "name": "openmate-browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "OpenMate 知识采集浏览器插件",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "^0.89.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "storage",
      "contextMenus",
      "sidePanel"
    ],
    "host_permissions": [
      "<all_urls>"
    ]
  }
}
