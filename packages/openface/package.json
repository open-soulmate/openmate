{
  "name": "@opensoulmate/openface",
  "version": "0.1.0",
  "description": "Soulmate UI component library — design tokens, hooks, chart wrappers, and React components.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js",
      "require": "./dist/charts/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs"
    },
    "./styles": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tailwindcss -i src/styles.css -o dist/index.css --minify",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-soulmate/openface.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "ui",
    "components",
    "design-tokens",
    "echarts",
    "tailwindcss"
  ],
  "license": "MIT",
  "dependencies": {
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@plantuml/core": "^1.2026.7",
    "apache-arrow": "^21.2.0",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "hls.js": "^1.7.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.500.0",
    "mermaid": "^11.17.2",
    "omnimail": "^1.0.0",
    "parquet-wasm": "^0.7.2",
    "pptx-preview": "^1.0.7",
    "shapefile": "^0.6.6",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.0.0",
    "three": "^0.185.1",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "docx-preview": ">=0.1.0",
    "jspdf": ">=2.0.0",
    "next": ">=16.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-i18next": ">=15.0.0",
    "xlsx": ">=0.18.0"
  },
  "peerDependenciesMeta": {
    "docx-preview": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "postcss": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.9.0"
  }
}
